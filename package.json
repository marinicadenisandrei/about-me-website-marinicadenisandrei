{
  "name": "denis-marinica-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal website / professional portfolio of Marinică Denis-Andrei, Astro + content collections + Luminary glass design.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "postbuild": "node scripts/prune-dev.mjs && node scripts/check-links.mjs",
    "build:subpath": "BASE_PATH=/preview-subpath npm run build",
    "preview": "astro preview",
    "styleguide": "STYLEGUIDE=1 astro build && astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "import:udemy": "node scripts/import-udemy.ts",
    "og": "python3 scripts/make-og.py && python3 scripts/make-og.py --projects",
    "logos": "node scripts/make-tech-logos.mjs",
    "test:links": "node scripts/check-links.mjs",
    "privacy": "node scripts/privacy-check.mjs . --dist",
    "test": "npm run check && npm run lint && npm run build && npm run privacy",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/montserrat": "^5.3.0",
    "astro": "^7.4.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@tabler/icons": "^3.51.0",
    "@types/node": "^26.6.6",
    "devicon": "^2.18.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "globals": "^17.14.0",
    "simple-icons": "^16.37.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "unist-util-visit": "^5.2.0"
  }
}

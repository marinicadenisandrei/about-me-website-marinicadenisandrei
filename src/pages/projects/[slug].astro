---
/**
 * Project detail: breadcrumbs -> header (shared-element target of the card title) ->
 * problem / solution / my contribution / stack / outcomes / links -> MDX body -> prev/next.
 */
import Icon from '@components/Icon.astro';
import { render } from 'astro:content';
import Base from '@layouts/Base.astro';
import Pill from '@components/Pill.astro';
import TechPill from '@components/TechPill.astro';
import GlassCard from '@components/GlassCard.astro';
import EuBadge from '@components/EuBadge.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import PrevNext from '@components/PrevNext.astro';
import { site } from '@config/site';
import { CATEGORY_META } from '@config/categories';
import { getProjects, projectSlug, projectClientLabel, uniqueTech } from '@lib/content';
import { formatRange } from '@lib/format';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const all = await getProjects();
  return all.map((p, i) => ({
    params: { slug: projectSlug(p) },
    props: { project: p, prev: all[i - 1] ?? null, next: all[i + 1] ?? null },
  }));
}
interface Props { project: CollectionEntry<'projects'>; prev: CollectionEntry<'projects'> | null; next: CollectionEntry<'projects'> | null }
const { project: p, prev, next } = Astro.props;
const slug = projectSlug(p);
const { Content } = await render(p);
const client = await projectClientLabel(p);
const outcomes = p.data.outcomes.filter((o) => !o.startsWith('TODO'));
const linkEntries = [
  p.data.links.live && { label: 'Website', url: p.data.links.live },
  p.data.links.repo && { label: 'Repository', url: p.data.links.repo },
  p.data.links.paper && { label: 'Paper', url: p.data.links.paper },
  p.data.links.demo && { label: 'Demo', url: p.data.links.demo },
  p.data.links.docs && { label: 'Docs', url: p.data.links.docs },
  ...p.data.links.other,
].filter(Boolean) as { label: string; url: string }[];
const ui = site.ui.projects;
---

<Base title={p.data.title} description={p.data.summary} tint={p.data.category} image={`/og/projects/${slug}.png`} type="article">
  <article class="project" data-tint={p.data.category}>
    <header class="page-head project-head" data-label={p.data.title}>
      <Breadcrumbs items={[{ label: 'Projects', href: '/projects' }, { label: p.data.title }]} />
      <div class="project-meta">
        <Pill dot>{CATEGORY_META[p.data.category].label}</Pill>
        <span class="project-status" data-status={p.data.status}>{ui.status[p.data.status]}</span>
        <span class="project-date">{formatRange(p.data.startDate, p.data.endDate)}</span>
      </div>
      <h1 class="section-title" transition:name={`project-${slug}`}>{p.data.title}</h1>
      <p class="section-body project-sub">{p.data.role}{client && <>, {client}</>}{p.data.organization && !client && <>, {p.data.organization}</>}</p>
      <p class="section-body">{p.data.summary}</p>
      {p.data.euFunded && <div class="project-eu"><EuBadge size="lg" programme={p.data.euFunded.programme} /></div>}
    </header>

    <div class="project-grid">
      {p.data.problem && <GlassCard lift={false} spot={false} class="reveal"><h2 class="ph">{ui.problem}</h2><p class="pb">{p.data.problem}</p></GlassCard>}
      {p.data.solution && <GlassCard lift={false} spot={false} class="reveal reveal-d1"><h2 class="ph">{ui.solution}</h2><p class="pb">{p.data.solution}</p></GlassCard>}
    </div>

    <section class="project-section reveal" aria-labelledby="contrib">
      <h2 class="ph" id="contrib">{ui.contribution}</h2>
      <ul class="project-list">{p.data.myContribution.map((c) => <li>{c}</li>)}</ul>
    </section>

    {p.data.stack.length > 0 && (
      <section class="project-section reveal" aria-labelledby="stack">
        <h2 class="ph" id="stack">{ui.stack}</h2>
        <div class="project-stack">{uniqueTech(p.data.stack).map((s) => <TechPill slug={s} />)}</div>
      </section>
    )}

    {outcomes.length > 0 && (
      <section class="project-section reveal" aria-labelledby="outcomes">
        <h2 class="ph" id="outcomes">{ui.outcomes}</h2>
        <ul class="project-list">{outcomes.map((o) => <li>{o}</li>)}</ul>
      </section>
    )}

    {linkEntries.length > 0 && (
      <section class="project-section reveal" aria-labelledby="links">
        <h2 class="ph" id="links">{ui.links}</h2>
        <div class="project-links">{linkEntries.map((l) => <a class="btn btn--secondary btn--sm" href={l.url} target="_blank" rel="noopener noreferrer">{l.label} <Icon name="external" /></a>)}</div>
      </section>
    )}

    <div class="prose project-body"><Content /></div>

    <PrevNext
      prev={prev ? { label: prev.data.title, href: `/projects/${projectSlug(prev)}` } : undefined}
      next={next ? { label: next.data.title, href: `/projects/${projectSlug(next)}` } : undefined}
      allHref="/projects"
      allLabel="All projects"
    />
  </article>
</Base>

<style>
  .project-head { padding-bottom: 32px; }
  .project-eu { margin-top: 22px; }
  .project-meta { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; margin-bottom: 18px; }
  .project-status { font-family: var(--font-display); font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--fg-subtle); display: inline-flex; align-items: center; gap: 6px; }
  .project-status::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--fg-subtle); }
  .project-status[data-status='active']::before { background: hsl(150 60% 50%); box-shadow: 0 0 8px hsl(150 60% 50% / 0.6); }
  .project-date { font-family: var(--font-display); font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--fg-subtle); }
  .project-sub { color: var(--fg-subtle); margin-top: -8px; }
  .project-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 20px; margin-bottom: 48px; }
  .ph { font-family: var(--font-display); font-size: 10px; font-weight: 600; letter-spacing: 0.25em; text-transform: uppercase; color: hsl(var(--tint-h) 70% 70%); margin-bottom: 14px; }
  .pb { font-size: 0.95rem; line-height: 1.75; color: var(--fg-muted); }
  .project-section { margin-bottom: 44px; }
  .project-list { list-style: none; display: grid; gap: 10px; max-width: 760px; }
  .project-list li { display: flex; gap: 12px; font-size: 0.95rem; line-height: 1.65; color: var(--fg-muted); }
  .project-list li::before { content: ''; flex-shrink: 0; width: 5px; height: 5px; border-radius: 50%; background: hsl(var(--tint-h) 70% 60%); margin-top: 10px; }
  .project-stack, .project-links { display: flex; flex-wrap: wrap; gap: 8px; }
  .project-body { margin-top: 56px; padding-top: 48px; border-top: 1px solid var(--line); }
  @media (max-width: 768px) { .project-grid { grid-template-columns: minmax(0, 1fr); } }
</style>

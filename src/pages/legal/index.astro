---
import LegalLayout from '@components/LegalLayout.astro';
import { business } from '@config/business';
import { site } from '@config/site';
const rows: [string, string][] = [
  ['Business name', business.legalName],
  ['Trade name', business.tradeName],
  ['Tax ID (CUI/CIF)', business.taxId],
  ['Trade Register no. (ONRC)', business.tradeRegisterNo],
  ['Registered office', business.registeredOffice],
  ['Main activity (CAEN)', `${business.caen.code} - ${business.caen.label}`],
  ['VAT registered', business.vatRegistered ? 'Yes' : 'No'],
  ['Billing email', business.billingEmail],
  ['Country', business.country],
];
const todo = (v: string) => v.startsWith('TODO');
---

<LegalLayout title="Business details" description={`Legal identification details of ${business.tradeName}.`} crumb="Legal">
  <p>Information required by Romanian law (OUG 34/2014, Law 365/2002) for services offered through this website by the sole proprietorship (PFA) below. For personal data, see the <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/legal/privacy`}>privacy policy</a>.</p>
  <table>
    <tbody>{rows.map(([k, v]) => <tr><th scope="row">{k}</th><td>{todo(v) ? <span class="todo">{v}</span> : v}</td></tr>)}</tbody>
  </table>
  <h2>Contact</h2>
  <p>Use the <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/contact`}>contact page</a>; the email address is shown there. Consumer disputes: ANPC (<a href="https://anpc.ro" rel="noopener noreferrer" target="_blank">anpc.ro</a>) and the EU online dispute resolution platform (<a href="https://ec.europa.eu/consumers/odr" rel="noopener noreferrer" target="_blank">ec.europa.eu/consumers/odr</a>).</p>
  <h2>Credits</h2>
  <p>Site built with Astro by {site.name}. Design based on the Luminary template by <a href="https://templatemo.com" rel="nofollow noopener noreferrer" target="_blank">TemplateMo</a>.</p>
</LegalLayout>

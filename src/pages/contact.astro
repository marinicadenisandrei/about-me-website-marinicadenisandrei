---
/**
 * Contact: avatar, obfuscated email (assembled client-side), LinkedIn/GitHub, Web3Forms form
 * (honeypot + no JS fallback), and the Calendly "Book a call" facade next to the form.
 */
import Base from '@layouts/Base.astro';
import Avatar from '@components/Avatar.astro';
import GlassCard from '@components/GlassCard.astro';
import BookCall from '@components/BookCall.astro';
import { site } from '@config/site';
import { personJsonLd } from '@lib/jsonld';

const ui = site.ui.contact;
const key = site.features.contactForm.key;
const [user, domain] = site.email.split('@');
const links = [
  { label: 'LinkedIn', url: site.links.linkedin },
  { label: 'GitHub', url: site.links.github },
].filter((l) => l.url && !l.url.includes('TODO'));
---

<Base title="Contact" description={`Contact ${site.name}: email, LinkedIn, a 30-minute intro call or the contact form.`} tint="freelance" hideCta jsonLd={[personJsonLd(Astro.site)]}>
  <section class="page-head contact-head" data-label="Contact">
    <Avatar size={96} glow priority />
    <div>
      <p class="section-tag">{ui.tag}</p>
      <h1 class="section-title" set:html={ui.title} />
      <p class="section-body">B2B projects, research collaborations, teaching or just a question. Pick whichever is easiest. I reply within two working days.</p>
    </div>
  </section>

  <section class="contact-grid" data-label="Contact options">
    <GlassCard tint="freelance" lift={false} spot={false} as="section" aria-labelledby="direct">
      <h2 class="ch" id="direct">Direct</h2>
      <ul class="contact-list">
        <li>
          <span class="ck">Email</span>
          {/* assembled client-side so scrapers don't get a plain address; noscript shows a hint */}
          <a class="cv-email" data-u={user} data-d={domain} href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/contact#direct`} rel="nofollow">{user}&nbsp;[at]&nbsp;{domain}</a>
          <noscript><span class="cv-email-ns">{user} [at] {domain}</span></noscript>
        </li>
        {links.map((l) => <li><span class="ck">{l.label}</span><a href={l.url} target="_blank" rel="noopener noreferrer">{l.url.replace(/^https?:\/\/(www\.)?/, '')}</a></li>)}
        <li><span class="ck">Location</span><span>{site.location}, remote-first, EET/EEST</span></li>
      </ul>
      <div class="contact-book">
        <h2 class="ch">{site.booking.label}</h2>
        <BookCall page="contact" variant="primary" label={site.booking.label} disclosure="full" />
      </div>
    </GlassCard>

    <GlassCard tint="freelance" lift={false} spot={false} as="section" aria-labelledby="formh">
      <h2 class="ch" id="formh">{ui.send}</h2>
      <div class="form-wrap" data-form-wrap>
      <form class="form" action="https://api.web3forms.com/submit" method="POST" data-contact-form data-mode={key ? 'web3forms' : 'mailto'} data-u={user} data-d={domain} data-sending={ui.sending} data-success={ui.success} data-error={ui.error}>
        <input type="hidden" name="access_key" value={key} />
        <input type="hidden" name="subject" value={`New message from ${site.shortName}'s website`} data-subject />
        <input type="hidden" name="from_name" value={`${site.name} (website)`} />
        <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="field-group">
          <label class="field"><span>{ui.name}</span><input type="text" name="name" required autocomplete="name" placeholder="Your name" /></label>
          <label class="field"><span>{ui.email}</span><input type="email" name="email" required autocomplete="email" placeholder="you@company.com" /></label>
          <label class="field"><span>{ui.message}</span><textarea name="message" rows="5" required placeholder="A few lines about the project, the role or the question"></textarea></label>
        </div>
        <button class="btn btn--primary btn--block form-send" type="submit">
          <span class="form-send-label">{key ? ui.send : 'Send email'}</span>
          <svg class="form-send-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12l16-8-6 16-2.5-6.5z" /></svg>
        </button>
        {!key && <button class="form-alt" type="button" data-gmail><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3" /><path d="M3.5 6.5l8.5 6.5 8.5-6.5" /></svg>Prefer Gmail? Open it there</button>}
        <p class="form-status" role="status" aria-live="polite" data-status></p>
        {key
          ? <p class="form-note">Delivered straight to my inbox through Web3Forms (third-party); your email is set as the reply address, so I answer you directly. Nothing is stored by this site.</p>
          : <p class="form-note">Opens your email app with the message ready to send to my inbox. Nothing is sent or stored by this site.</p>}
      </form>
      <div class="sent" data-sent hidden>
        <span class="sent-badge" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span>
        <p class="sent-title" data-sent-title>Message sent</p>
        <p class="sent-body" data-sent-body>{ui.success} I usually reply within two working days.</p>
        <button class="btn btn--secondary btn--sm" type="button" data-sent-again>Send another message</button>
      </div>
      </div>
    </GlassCard>
  </section>
</Base>

<style>
  .contact-head { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 40px; align-items: start; }
  .contact-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 20px; padding-bottom: 40px; }
  .ch { font-family: var(--font-display); font-size: 10px; font-weight: 600; letter-spacing: 0.25em; text-transform: uppercase; color: hsl(var(--tint-h) 70% 70%); margin-bottom: 16px; }
  .contact-list { list-style: none; display: grid; gap: 14px; margin-bottom: 32px; }
  .contact-list li { display: grid; gap: 4px; font-size: 0.92rem; color: var(--fg-muted); }
  .contact-list a { color: var(--fg); text-decoration: none; word-break: break-all; }
  .contact-list a:hover { text-decoration: underline; }
  .ck { font-family: var(--font-display); font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--fg-subtle); }
  .contact-book { padding-top: 24px; border-top: 1px solid var(--line); }
  .contact-book :global(.book) { align-items: flex-start; }
  .contact-book :global(.book-note) { text-align: left; }
  .form-wrap { position: relative; }
  .form { display: flex; flex-direction: column; gap: 16px; }
  .form[hidden] { display: none; }
  .hp { position: absolute; left: -9999px; opacity: 0; }
  /* iOS grouped inset list: one rounded group, hairline separators */
  .field-group { border-radius: 18px; overflow: hidden; border: 1px solid var(--glass-border); background: color-mix(in srgb, var(--panel-bg) 70%, transparent); }
  .field { display: flex; flex-direction: column; gap: 4px; padding: 12px 16px; font-family: var(--font-display); font-size: 9px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--fg-subtle); transition: background 0.3s ease; }
  .field + .field { border-top: 1px solid var(--line); }
  .field:focus-within { background: hsl(var(--tint-h) 70% 60% / 0.07); color: hsl(var(--tint-h) 70% 60%); }
  .field input, .field textarea { font-family: var(--font-ui); font-size: 0.98rem; letter-spacing: 0; text-transform: none; color: var(--fg); padding: 2px 0; border: 0; background: transparent; outline: none; resize: vertical; }
  .field input::placeholder, .field textarea::placeholder { color: var(--fg-subtle); opacity: 0.7; }
  .form-send { gap: 10px; min-height: 48px; border-radius: 14px; }
  .form-send-ico { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linejoin: round; transition: transform 0.5s var(--spring-bouncy, ease); }
  .form-send:hover .form-send-ico { transform: translate(3px, -3px); }
  .form-send[disabled] { opacity: 0.7; cursor: progress; }
  .form-send[disabled] .form-send-ico { animation: send-fly 0.9s ease-in-out infinite; }
  @keyframes send-fly { 50% { transform: translate(5px, -5px); opacity: 0.4; } }
  .form-alt { align-self: center; display: inline-flex; align-items: center; gap: 8px; margin-top: -4px; padding: 8px 14px; border-radius: 100px; border: 1px solid var(--line); background: transparent; color: var(--fg-muted); font-size: 0.8rem; cursor: pointer; transition: background 0.2s, color 0.2s; }
  .form-alt:hover { background: color-mix(in srgb, var(--fg) 6%, transparent); color: var(--fg); }
  .form-alt svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linejoin: round; }
  .form-status { font-size: 0.85rem; color: var(--fg); min-height: 1.2em; margin: 0; }
  .form-status[data-state='error'] { color: hsl(0 70% 65%); }
  .sent { display: grid; justify-items: center; text-align: center; gap: 10px; padding: 48px 12px; animation: sent-in 0.6s var(--spring-smooth, ease) both; }
  .sent[hidden] { display: none; }
  .sent-badge { width: 72px; height: 72px; border-radius: 50%; display: grid; place-items: center; background: linear-gradient(135deg, #34D399, #10B981); box-shadow: 0 12px 30px rgba(16, 185, 129, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.4); animation: sent-pop 0.7s var(--spring-bouncy, ease) both; }
  .sent-badge svg { width: 34px; height: 34px; fill: none; stroke: #fff; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 30; stroke-dashoffset: 30; animation: sent-draw 0.5s 0.25s ease-out forwards; }
  .sent-title { margin: 8px 0 0; font-family: var(--font-display); font-size: 1.2rem; font-weight: 600; color: var(--fg); }
  .sent-body { margin: 0 0 10px; max-width: 320px; font-size: 0.9rem; color: var(--fg-muted); }
  @keyframes sent-in { from { opacity: 0; transform: translateY(8px); } }
  @keyframes sent-pop { from { transform: scale(0.4); opacity: 0; } }
  @keyframes sent-draw { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { .sent, .sent-badge, .sent-badge svg { animation: none; stroke-dashoffset: 0; } }
  .form-note { font-size: 0.68rem; color: var(--fg-subtle); line-height: 1.4; }
  @media (max-width: 900px) { .contact-grid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 640px) { .contact-head { grid-template-columns: minmax(0, 1fr); gap: 20px; } }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    // Assemble the mailto on the client, the HTML never contains the address.
    document.querySelectorAll<HTMLAnchorElement>('.cv-email:not([data-bound])').forEach((a) => {
      a.dataset.bound = '';
      const addr = `${a.dataset.u}@${a.dataset.d}`;
      a.textContent = addr;
      a.href = `mailto:${addr}`;
    });
    // Progressive enhancement: submit via fetch, show status inline; without JS the form posts normally.
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]:not([data-bound])');
    if (!form) return;
    form.dataset.bound = '';
    const status = form.querySelector<HTMLElement>('[data-status]');
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]');
    const wrap = document.querySelector<HTMLElement>('[data-form-wrap]');
    const sent = wrap?.querySelector<HTMLElement>('[data-sent]');
    const subject = form.querySelector<HTMLInputElement>('[data-subject]');
    wrap?.querySelector('[data-sent-again]')?.addEventListener('click', () => {
      if (sent) sent.hidden = true;
      form.hidden = false;
      form.querySelector<HTMLInputElement>('input[name=name]')?.focus();
    });
    const to = `${form.dataset.u}@${form.dataset.d}`;
    const compose = () => {
      const get = (n: string) => (form.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name=${n}]`)?.value ?? '').trim();
      const name = get('name');
      return {
        subject: `Website enquiry from ${name || 'a visitor'}`,
        body: `${get('message')}\n\n${name}\n${get('email')}`,
      };
    };
    const showSent = (title: string, body: string) => {
      form.hidden = true;
      if (!sent) return;
      const t = sent.querySelector<HTMLElement>('[data-sent-title]');
      const b = sent.querySelector<HTMLElement>('[data-sent-body]');
      if (t) t.textContent = title;
      if (b) b.textContent = body;
      sent.hidden = false;
      sent.querySelector('button')?.focus();
    };
    form.querySelector('[data-gmail]')?.addEventListener('click', () => {
      if (!form.reportValidity()) return;
      const m = compose();
      const url = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(to)}&su=${encodeURIComponent(m.subject)}&body=${encodeURIComponent(m.body)}`;
      window.open(url, '_blank', 'noopener');
      showSent('Draft ready in Gmail', 'Your message is waiting in a Gmail tab. Press Send there and it lands in my inbox.');
    });
    form.addEventListener('submit', async (e) => {
      if (form.dataset.mode === 'mailto') {
        e.preventDefault();
        const m = compose();
        window.location.href = `mailto:${to}?subject=${encodeURIComponent(m.subject)}&body=${encodeURIComponent(m.body)}`;
        showSent('Almost there', 'Your email app opened with the message ready. Press Send there and it lands in my inbox.');
        return;
      }
      e.preventDefault();
      const name = (form.querySelector<HTMLInputElement>('input[name=name]')?.value ?? '').trim();
      if (subject && name) subject.value = `New message from ${name} via your website`;
      if (status) { status.dataset.state = ''; status.textContent = form.dataset.sending ?? ''; }
      if (btn) btn.disabled = true;
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const data = (await res.json()) as { success?: boolean };
        if (!res.ok || !data.success) throw new Error('failed');
        form.reset();
        if (status) status.textContent = '';
        showSent('Message sent', `${form.dataset.success ?? ''} I usually reply within two working days.`);
      } catch {
        if (status) { status.dataset.state = 'error'; status.textContent = form.dataset.error ?? ''; }
      } finally {
        if (btn) btn.disabled = false;
      }
    });
  });
</script>

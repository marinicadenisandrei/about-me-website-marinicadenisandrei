---
import Base from '@layouts/Base.astro';
import Link from '@components/Link.astro';
import { site } from '@config/site';
---

<Base title={site.ui.notFound.title} noindex>
  <section class="nf">
    <p class="code">404</p>
    <h1>{site.ui.notFound.title}</h1>
    <p>{site.ui.notFound.body}</p>
    <Link href="/" class="btn-primary">{site.ui.notFound.cta}</Link>
  </section>
</Base>

<style>
  .nf { min-height: 60vh; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; gap: 16px; }
  .code { font-family: var(--font-display); font-size: 6rem; font-weight: 200; letter-spacing: -0.05em; color: rgba(176, 184, 196, 0.12); line-height: 1; }
  h1 { font-size: 2rem; font-weight: 300; letter-spacing: -0.03em; }
  p { color: var(--slate-light); }
  .nf :global(.btn-primary) { margin-top: 24px; }
</style>

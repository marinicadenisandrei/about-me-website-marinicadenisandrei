---
/** Experience — vertical timeline; each card: highlights, stack pills, linked projects, expandable details. */
import { render } from 'astro:content';
import Base from '@layouts/Base.astro';
import SectionHeader from '@components/SectionHeader.astro';
import Timeline from '@components/Timeline.astro';
import TimelineItem from '@components/TimelineItem.astro';
import TechPill from '@components/TechPill.astro';
import Link from '@components/Link.astro';
import { site } from '@config/site';
import { getExperience, getProjects, projectSlug, uniqueTech } from '@lib/content';
import { formatRange, formatDuration } from '@lib/format';

const ui = site.ui.experience;
const experience = await getExperience();
const projects = await getProjects();
const items = await Promise.all(experience.map(async (e) => ({
  e,
  Content: (await render(e)).Content,
  hasBody: !!e.body?.trim(),
  linked: projects.filter((p) => p.data.experience?.id === e.id),
})));
const first = experience[experience.length - 1];
---

<Base title="Experience" description={`Career of ${site.name}: LSEG, Hitachi, Thales, Continental, Luxoft, Robital — DevOps, cloud, systems engineering and test automation.`} tint="industry">
  <section class="page-head" data-label="Experience">
    <SectionHeader tag={ui.tag} title={ui.title} body={`${experience.length} roles since ${first ? first.data.startDate.getFullYear() : ''} — from industrial robotics and automotive test automation to systems architecture and senior DevOps.`} as="h1" reveal={false} />
  </section>

  <Timeline>
    {items.map(({ e, Content, hasBody, linked }, i) => (
      <TimelineItem date={formatRange(e.data.startDate, e.data.endDate)} duration={formatDuration(e.data.startDate, e.data.endDate)} tint={e.data.tint} current={i === 0}>
        <div class="xp-head">
          <div>
            <p class="section-tag xp-company">{e.data.companyUrl ? <a href={e.data.companyUrl} target="_blank" rel="noopener noreferrer">{e.data.company}</a> : e.data.company} <span class="xp-meta">· {e.data.employmentType.replace('-', ' ')} · {e.data.location}</span></p>
            <h2 class="xp-role">{e.data.role}</h2>
          </div>
        </div>
        <p class="xp-summary">{e.data.summary}</p>
        <ul class="xp-highlights">{e.data.highlights.map((h) => <li>{h}</li>)}</ul>
        {linked.length > 0 && (
          <p class="xp-linked">Projects: {linked.map((p, j) => <>{j > 0 && ', '}<Link href={`/projects/${projectSlug(p)}`}>{p.data.title}</Link></>)}</p>
        )}
        <div class="xp-stack">{uniqueTech(e.data.stack).slice(0, 12).map((s) => <TechPill slug={s} />)}{uniqueTech(e.data.stack).length > 12 && <span class="pill pill--neutral">+{uniqueTech(e.data.stack).length - 12}</span>}</div>
        {hasBody && (
          <details class="xp-details">
            <summary>Full description</summary>
            <div class="prose xp-prose"><Content /></div>
          </details>
        )}
      </TimelineItem>
    ))}
  </Timeline>
</Base>

<style>
  .xp-head { margin-bottom: 10px; }
  .xp-company { margin-bottom: 8px; display: flex; flex-wrap: wrap; gap: 6px; align-items: baseline; }
  .xp-company a { color: inherit; text-decoration: none; }
  .xp-company a:hover { color: var(--fg); }
  .xp-meta { text-transform: none; letter-spacing: 0.05em; font-weight: 400; }
  .xp-role { font-size: 1.25rem; font-weight: 500; letter-spacing: -0.02em; color: var(--fg); line-height: 1.3; }
  .xp-summary { font-size: 0.92rem; line-height: 1.65; color: var(--fg-muted); margin-bottom: 14px; }
  .xp-highlights { list-style: none; display: grid; gap: 8px; font-size: 0.88rem; line-height: 1.55; color: var(--fg-muted); margin-bottom: 16px; }
  .xp-highlights li { display: flex; gap: 10px; }
  .xp-highlights li::before { content: ''; flex-shrink: 0; width: 4px; height: 4px; border-radius: 50%; background: hsl(var(--tint-h) 70% 60%); margin-top: 9px; }
  .xp-linked { font-size: 0.84rem; color: var(--fg-subtle); margin-bottom: 14px; }
  .xp-linked a { color: var(--fg); text-decoration: none; }
  .xp-linked a:hover { text-decoration: underline; }
  .xp-stack { display: flex; flex-wrap: wrap; gap: 6px; }
  .xp-details { margin-top: 18px; border-top: 1px solid var(--line); padding-top: 14px; }
  .xp-details summary { cursor: pointer; font-family: var(--font-display); font-size: 9px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--fg-subtle); list-style: none; display: inline-flex; gap: 8px; align-items: center; }
  .xp-details summary::-webkit-details-marker { display: none; }
  .xp-details summary::after { content: '+'; font-size: 12px; }
  .xp-details[open] summary::after { content: '−'; }
  .xp-prose { margin-top: 14px; font-size: 0.9rem; }
</style>

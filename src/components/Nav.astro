---
/**
 * Floating, centred glass pill navigation (Safari / macOS tab-bar style).
 * - persists across client-side navigations (transition:persist); the active link is
 *   re-resolved on astro:page-load and a glass indicator slides to it with a spring
 * - shrinks when scrolling down, expands again on scroll up
 * - on mobile the pill morphs into the bottom sheet (see MobileMenu.astro)
 */
import Link from '@components/Link.astro';
import ThemeToggle from '@components/ThemeToggle.astro';
import BrandLockup from '@components/BrandLockup.astro';
import { site } from '@config/site';
import { withBase } from '@lib/url';
---

<header class="nav-wrap" id="topNav" transition:persist transition:name="nav-shell">
  <nav class="top-nav glass glass--thick glass--pill" aria-label="Main" data-nav>
    <BrandLockup size={30} transitionName="portrait" />
    <ul class="nav-links" data-nav-links>
      <li class="nav-indicator" aria-hidden="true"></li>
      {site.nav.map((n) => (
        <li><Link href={n.href} data-href={withBase(n.href)}>{n.label}</Link></li>
      ))}
    </ul>
    <div class="nav-actions">
      <ThemeToggle />
      <Link href="/services" class="nav-cta">{site.ui.ctaWorkWithMe}</Link>
      <button class="nav-toggle" id="navToggle" aria-label={site.ui.menu} aria-expanded="false" aria-controls="mobileMenu">
        <span class="toggle-bar"></span><span class="toggle-bar"></span>
      </button>
    </div>
  </nav>
</header>

<style>
  .nav-wrap {
    position: fixed; top: 0; left: 0; right: 0; z-index: 600;
    display: flex; justify-content: center;
    padding: 18px 20px 0;
    transition: padding var(--dur-smooth) var(--spring-smooth);
    pointer-events: none;
  }
  .top-nav {
    pointer-events: auto;
    display: flex; align-items: center; gap: 24px;
    padding: 8px 8px 8px 12px;
    width: min(1180px, 100%);
    transition: padding var(--dur-smooth) var(--spring-smooth), width var(--dur-smooth) var(--spring-smooth), box-shadow var(--dur-smooth) var(--spring-smooth), transform var(--dur-smooth) var(--spring-smooth);
  }
  /* scrolling down: compact pill; scrolling up: expanded again */
  .nav-wrap.scrolled { padding-top: 10px; }
  .nav-wrap.scrolled .top-nav { width: min(1080px, 100%); padding: 6px 6px 6px 10px; }
  .nav-wrap.scrolled.down .top-nav { width: auto; max-width: min(1080px, 100%); padding: 4px 4px 4px 8px; gap: 16px; }
  .nav-wrap.scrolled.down .nav-links a { padding: 10px 0 4px; }
  .nav-wrap.scrolled.down .nav-cta { padding: 8px 18px; }
  .nav-wrap.scrolled.down :global(.lockup-text) { font-size: 11px; }

  .nav-links { display: flex; gap: 22px; list-style: none; align-items: center; margin-left: auto; position: relative; }
  .nav-links a {
    font-family: var(--font-display); font-size: 10px; font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--fg-subtle); text-decoration: none; position: relative; padding: 14px 0 6px; white-space: nowrap; z-index: 1;
    transition: color var(--dur-smooth) var(--spring-smooth), padding var(--dur-smooth) var(--spring-smooth);
  }
  .nav-links a::after {
    content: ''; position: absolute; top: 2px; left: 50%; width: 6px; height: 6px;
    border-right: 1px solid var(--accent); border-bottom: 1px solid var(--accent);
    transform: translateX(-50%) rotate(45deg) translateY(-8px);
    opacity: 0; transition: transform 0.8s var(--silk-ease), opacity 0.6s var(--silk-ease); pointer-events: none;
  }
  .nav-links a:hover { color: var(--fg); }
  .nav-links a:hover::after { opacity: 0.7; transform: translateX(-50%) rotate(45deg) translateY(0); }
  .nav-links a.active { color: var(--fg); }
  /* sliding glass indicator behind the active link */
  .nav-indicator {
    position: absolute; top: 50%; left: 0; height: 28px; width: 0; transform: translate(0, -50%); z-index: 0;
    border-radius: var(--radius-full); opacity: 0;
    background: linear-gradient(135deg, var(--glass-hi), var(--glass-lo)), hsl(var(--tint-h) 70% 60% / 0.14);
    border: 1px solid var(--glass-border); box-shadow: inset 0 1px 0 var(--glass-inner);
    transition: transform var(--dur-smooth) var(--spring-smooth), width var(--dur-smooth) var(--spring-smooth), opacity 0.4s;
    pointer-events: none;
  }
  .nav-links[data-ready] .nav-indicator { opacity: 1; }

  .nav-actions { display: flex; align-items: center; gap: 8px; margin-left: auto; }
  .nav-links + .nav-actions { margin-left: 0; }
  .nav-cta {
    padding: 10px 22px; border-radius: var(--radius-full);
    font-family: var(--font-display); font-size: 10px; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase;
    background: var(--tint-grad);
    color: var(--tint-ink); text-decoration: none; white-space: nowrap;
    box-shadow: 0 4px 16px hsl(var(--tint-h) 70% 50% / 0.3), inset 0 1px 0 rgba(255,255,255,0.3);
    transition: transform var(--dur-snappy) var(--spring-snappy), box-shadow var(--dur-smooth) var(--spring-smooth), padding var(--dur-smooth) var(--spring-smooth);
  }
  .nav-cta:hover { transform: scale(1.03); box-shadow: 0 6px 28px hsl(var(--tint-h) 70% 50% / 0.4), inset 0 1px 0 rgba(255,255,255,0.3); }
  .nav-cta:active { transform: scale(0.96); }

  .nav-toggle { display: none; background: none; border: none; cursor: pointer; width: 40px; height: 40px; position: relative; padding: 0; border-radius: 50%; }
  .toggle-bar { display: block; width: 18px; height: 1.5px; background: var(--fg); position: absolute; left: 11px; transition: transform 0.6s var(--spring-smooth), top 0.6s var(--spring-smooth); }
  .toggle-bar:nth-child(1) { top: 15px; }
  .toggle-bar:nth-child(2) { top: 23px; }
  .nav-toggle.active .toggle-bar:nth-child(1) { top: 19px; transform: rotate(45deg); }
  .nav-toggle.active .toggle-bar:nth-child(2) { top: 19px; transform: rotate(-45deg); }

  /* while the sheet is open the pill is hidden (it has morphed into the sheet) */
  :global(body.menu-open) .nav-wrap { opacity: 0; transition: opacity 0.2s; }
  :global(body.menu-open) .nav-wrap .top-nav { pointer-events: none; }

  @media (max-width: 1280px) {
    .nav-links { gap: 18px; }
  }
  @media (max-width: 1024px) {
    .nav-links, .nav-cta { display: none; }
    .nav-toggle { display: block; }
    .top-nav { padding: 6px 6px 6px 10px; gap: 12px; }
    .nav-actions, .nav-links + .nav-actions { margin-left: auto; }
  }
  @media (max-width: 768px) {
    .nav-wrap { padding: 12px 12px 0; }
  }
</style>

<script>
  function init() {
    const wrap = document.getElementById('topNav');
    if (!wrap) return;
    const links = wrap.querySelector<HTMLElement>('[data-nav-links]');
    const indicator = wrap.querySelector<HTMLElement>('.nav-indicator');
    const anchors = [...wrap.querySelectorAll<HTMLAnchorElement>('[data-nav-links] a')];

    // Active link — re-resolved on every navigation because the header persists.
    const path = location.pathname.replace(/\/+$/, '') || '/';
    let active: HTMLAnchorElement | undefined;
    for (const a of anchors) {
      const h = (a.dataset.href ?? '').replace(/\/+$/, '') || '/';
      const on = h === '/' ? path === '/' : path === h || path.startsWith(h + '/');
      a.classList.toggle('active', on);
      if (on) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
      if (on) active = a;
    }
    const moveTo = (a: HTMLElement | undefined) => {
      if (!indicator || !links) return;
      if (!a) { indicator.style.width = '0px'; links.removeAttribute('data-ready'); return; }
      const pad = 10;
      indicator.style.width = `${a.offsetWidth + pad * 2}px`;
      indicator.style.transform = `translate(${a.offsetLeft - pad}px, -50%)`;
      links.setAttribute('data-ready', '');
    };
    moveTo(active);
    if (!wrap.dataset.bound) {
      wrap.dataset.bound = '';
      anchors.forEach((a) => {
        a.addEventListener('mouseenter', () => moveTo(a));
        a.addEventListener('focus', () => moveTo(a));
      });
      links?.addEventListener('mouseleave', () => moveTo(wrap.querySelector<HTMLElement>('[data-nav-links] a.active') ?? undefined));
      addEventListener('resize', () => moveTo(wrap.querySelector<HTMLElement>('[data-nav-links] a.active') ?? undefined), { passive: true });

      // Scroll: compact on the way down, expand on the way up.
      let last = scrollY, ticking = false;
      const update = () => {
        ticking = false;
        const y = scrollY;
        wrap.classList.toggle('scrolled', y > 60);
        if (Math.abs(y - last) > 6) {
          wrap.classList.toggle('down', y > last && y > 120);
          last = y;
        }
      };
      addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
      update();
    } else {
      wrap.classList.toggle('scrolled', scrollY > 60);
      wrap.classList.remove('down');
    }
  }
  // Shared-element rule: the nav mark owns "portrait" everywhere except on /about, where the large
  // portrait owns it. The header persists, so this is toggled around each navigation.
  const base = (document.querySelector('[data-nav-links] a[data-href]') as HTMLAnchorElement | null)?.dataset.href?.replace(/\/about$/, '') ?? '';
  const isAbout = (p: string) => (p.replace(/\/+$/, '') || '/') === `${base}/about`;
  const setMark = (p: string) => {
    const mark = document.querySelector<HTMLElement>('#topNav .avatar');
    if (mark) mark.style.viewTransitionName = isAbout(p) ? 'none' : 'portrait';
  };
  document.addEventListener('astro:before-swap', (e) => setMark((e as unknown as { to: URL }).to.pathname));
  document.addEventListener('astro:page-load', () => setMark(location.pathname));
  document.addEventListener('astro:page-load', init);
</script>

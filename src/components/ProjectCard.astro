---
/** Project card for grids. Inherits the category tint automatically. */
import GlassCard from '@components/GlassCard.astro';
import Pill from '@components/Pill.astro';
import { site } from '@config/site';
import { CATEGORY_META } from '@config/categories';
import { formatRange } from '@lib/format';
import { techLabel, canonicalTech } from '@config/stack';
import { projectSlug, projectClientLabel } from '@lib/content';
import type { CollectionEntry } from 'astro:content';

interface Props { project: CollectionEntry<'projects'>; class?: string; reveal?: string }
const { project: p, class: cls, reveal } = Astro.props;
const slug = projectSlug(p);
const client = await projectClientLabel(p);
const bullets = p.data.myContribution.slice(0, 3);
const canon = [...new Set(p.data.stack.map(canonicalTech))];
const stack = canon.slice(0, 5);
const more = canon.length - stack.length;
---

<GlassCard href={`/projects/${slug}`} tint={p.data.category} as="article" class:list={['pc', reveal, cls]} data-category={p.data.category} data-status={p.data.status} data-stack={p.data.stack.join(' ')} data-title={p.data.title.toLowerCase()}>
  <div class="pc-top">
    <Pill dot>{CATEGORY_META[p.data.category].label}</Pill>
    <span class="pc-status" data-status={p.data.status}>{site.ui.projects.status[p.data.status]}</span>
  </div>
  <h3 class="pc-title" transition:name={`project-${slug}`}>{p.data.title}</h3>
  <p class="pc-meta">{p.data.role}{client && <> · {client}</>}</p>
  <p class="pc-summary">{p.data.summary}</p>
  <ul class="pc-bullets">{bullets.map((b) => <li>{b}</li>)}</ul>
  <div class="pc-foot">
    <div class="pc-stack">{stack.map((s) => <span class="pill pill--neutral">{techLabel(s)}</span>)}{more > 0 && <span class="pill pill--neutral">+{more}</span>}</div>
    <span class="pc-date">{formatRange(p.data.startDate, p.data.endDate)}</span>
  </div>
</GlassCard>

<style>
  .pc { gap: 14px; height: 100%; }
  .pc-top { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
  .pc-status { font-family: var(--font-display); font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--fg-subtle); display: inline-flex; align-items: center; gap: 6px; }
  .pc-status::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--fg-subtle); }
  .pc-status[data-status='active']::before { background: hsl(150 60% 50%); box-shadow: 0 0 8px hsl(150 60% 50% / 0.6); }
  .pc-status[data-status='completed']::before { background: hsl(var(--tint-h) 70% 60%); }
  .pc-title { font-size: 1.15rem; font-weight: 500; letter-spacing: -0.02em; line-height: 1.3; color: var(--fg); }
  .pc-meta { font-size: 0.78rem; color: var(--fg-subtle); margin-top: -8px; }
  .pc-summary { font-size: 0.88rem; line-height: 1.65; color: var(--fg-muted); }
  .pc-bullets { list-style: none; display: flex; flex-direction: column; gap: 6px; font-size: 0.82rem; color: var(--fg-muted); }
  .pc-bullets li { display: flex; gap: 10px; line-height: 1.5; }
  .pc-bullets li::before { content: ''; flex-shrink: 0; width: 4px; height: 4px; border-radius: 50%; background: hsl(var(--tint-h) 70% 60%); margin-top: 8px; }
  .pc-foot { margin-top: auto; padding-top: 14px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; flex-wrap: wrap; }
  .pc-stack { display: flex; flex-wrap: wrap; gap: 6px; }
  .pc-stack .pill { font-size: 8px; padding: 3px 9px; letter-spacing: 0.08em; }
  .pc-date { font-family: var(--font-display); font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--fg-subtle); white-space: nowrap; }
</style>

---
/**
 * Booking sheet: same design and motion as the mobile menu (iOS bottom sheet in the site's tinted glass),
 * sliding up from the bottom edge of the browser on every screen size.
 * Every [data-book-call] link opens it; the Calendly iframe is created only on the first open.
 * Closes on the close button, Esc, a tap on the backdrop or dragging the handle down.
 */
import { site } from '@config/site';
import { withBase } from '@lib/url';
---

<div class="bks" data-booking role="dialog" aria-modal="true" aria-labelledby="bks-title" hidden>
  <div class="bks-backdrop" data-booking-close></div>
  <div class="bks-panel" data-tint="freelance" data-booking-panel tabindex="-1">
    <div class="bks-drag" data-booking-drag><div class="bks-handle" aria-hidden="true"></div></div>
    <button class="bks-close" type="button" data-booking-close aria-label="Close">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
    <header class="bks-head">
      <p class="bks-tag"><span class="bks-live"></span>Book a call, {site.booking.durationMin} min, online</p>
      <h2 class="bks-title" id="bks-title">Pick a time for a <strong>30-minute intro call</strong></h2>
    </header>
    <div class="bks-frame" data-booking-frame>
      <div class="bks-loading">
        <span class="bks-spinner" aria-hidden="true">{Array.from({ length: 8 }, (_, i) => <i style={`--i:${i}`}></i>)}</span>
        <span>Loading available times</span>
      </div>
    </div>
    <p class="bks-foot">
      <span>{site.booking.disclosure}</span>
      <a href={withBase(site.booking.privacySectionPath)}>How your data is handled</a>
    </p>
  </div>
</div>

<style is:global>
  .bks { position: fixed; inset: 0; z-index: 700; }
  .bks[hidden] { display: none; }
  .bks-backdrop { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.45); opacity: 0; transition: opacity 0.5s ease; overscroll-behavior: contain; }
  .bks-panel {
    position: absolute; left: 0; right: 0; bottom: 0; margin: 0 auto; width: min(1120px, 100%);
    display: flex; flex-direction: column; height: min(calc(88dvh / var(--zoom, 1)), 860px);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0; border-bottom: 0;
    padding: 12px 24px calc(14px + env(safe-area-inset-bottom));
    transform: translate3d(0, 100%, 0); transition: transform 0.6s var(--silk-ease); outline: none;
    /* the look of .glass--thick without a live backdrop blur: a blur that is re-sampled every frame of the slide is what made it stutter */
    background:
      radial-gradient(120% 60% at 0% 0%, hsl(var(--tint-h) 70% 55% / 0.22), transparent 60%),
      radial-gradient(90% 60% at 100% 0%, hsl(calc(var(--tint-h) + 40) 70% 60% / 0.16), transparent 60%),
      color-mix(in srgb, var(--bg) 93%, hsl(var(--tint-h) 60% 50%));
    border: 1px solid var(--glass-border); border-bottom: 0;
    box-shadow: 0 -20px 60px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.16);
    contain: layout paint; backface-visibility: hidden;
  }
  .bks.animating .bks-panel { will-change: transform; }
  .bks.open .bks-backdrop { opacity: 1; }
  .bks.open .bks-panel { transform: translate3d(0, 0, 0); }
  .bks-panel.is-dragging { transition: none; }

  .bks-drag { flex: none; padding: 0 0 14px; cursor: grab; touch-action: none; }
  .bks-drag:active { cursor: grabbing; }
  .bks-handle { width: 40px; height: 5px; border-radius: 5px; background: var(--fg-subtle); opacity: 0.5; margin: 0 auto; }
  .bks-close { position: absolute; top: 14px; right: 16px; z-index: 3; width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--line); background: var(--panel-bg); color: var(--fg); display: grid; place-items: center; cursor: pointer; transition: transform 0.4s var(--spring-bouncy, ease); }
  .bks-close:hover { transform: rotate(90deg); }

  /* staggered content, like the menu links */
  .bks-head, .bks-frame, .bks-foot { opacity: 0; transform: translate3d(0, 16px, 0); transition: opacity 0.3s ease, transform 0.3s ease; }
  .bks.open .bks-head, .bks.open .bks-frame, .bks.open .bks-foot { opacity: 1; transform: none; transition: opacity 0.5s var(--silk-ease), transform 0.5s var(--silk-ease); }
  .bks.open .bks-head { transition-delay: 0.08s; }
  .bks.open .bks-frame { transition-delay: 0.16s; }
  .bks.open .bks-foot { transition-delay: 0.3s; }

  .bks-head { flex: none; padding: 0 48px 16px 4px; }
  .bks-tag { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 8px; font-family: var(--font-display); font-size: 10px; font-weight: 600; letter-spacing: 0.25em; text-transform: uppercase; color: hsl(var(--tint-h) 70% 60%); }
  .bks-live { width: 6px; height: 6px; border-radius: 50%; background: #34D399; animation: bks-ping 2s ease-out infinite; }
  .bks-title { margin: 0; font-family: var(--font-display); font-size: clamp(1.4rem, 3vw, 2rem); font-weight: 300; letter-spacing: -0.02em; line-height: 1.15; color: var(--fg); }
  .bks-title strong { font-weight: 600; }

  .bks-frame { position: relative; flex: 1; min-height: 0; border-radius: var(--radius-md, 20px); overflow: hidden; background: #fff; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12), inset 0 0 0 1px rgba(15, 23, 42, 0.06); }
  .bks-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; opacity: 0; transition: opacity 0.45s ease; }
  .bks-frame.is-ready iframe { opacity: 1; }
  .bks-loading { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 14px; font-size: 0.82rem; color: #6B7280; transition: opacity 0.3s ease; }
  .bks-frame.is-ready .bks-loading { opacity: 0; pointer-events: none; }
  .bks-spinner { position: relative; width: 28px; height: 28px; }
  .bks-spinner i { position: absolute; left: 12.5px; top: 0; width: 3px; height: 8px; border-radius: 2px; background: #8E8E93; transform-origin: 1.5px 14px; transform: rotate(calc(var(--i) * 45deg)); animation: bks-spin 0.8s linear infinite; animation-delay: calc(var(--i) * 0.1s - 0.8s); }

  .bks-foot { flex: none; margin: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 10px; padding-top: 12px; font-family: var(--font-display); font-size: 10px; letter-spacing: 0.06em; color: var(--fg-subtle); text-align: center; }
  .bks-foot a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }

  @media (max-width: 640px) {
    .bks-panel { height: 92dvh; padding: 12px 12px calc(10px + env(safe-area-inset-bottom)); }
    .bks-head { padding: 0 48px 12px 8px; }
  }
  @keyframes bks-ping { 0% { box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.55); } 80%, 100% { box-shadow: 0 0 0 6px rgba(52, 211, 153, 0); } }
  @keyframes bks-spin { from { opacity: 1; } to { opacity: 0.15; } }
  @media (prefers-reduced-motion: reduce) { .bks-panel, .bks-backdrop, .bks-head, .bks-frame, .bks-foot { transition-duration: 0.01s !important; } }
</style>

<script>
  /**
   * One delegated click handler for every [data-book-call] link (the module runs once, even with view transitions);
   * the current page's sheet is looked up at click time. With a modified click the link opens Calendly in a new tab.
   */
  const bound = new WeakMap<HTMLElement, (url: string, from: HTMLElement) => void>();

  function bind(sheet: HTMLElement) {
    const panel = sheet.querySelector<HTMLElement>('[data-booking-panel]');
    const frame = sheet.querySelector<HTMLElement>('[data-booking-frame]');
    let loadedUrl = '';
    let opener: HTMLElement | null = null;
    let hideTimer: number | undefined;

    // keep the page from scrolling behind the sheet without touching overflow (that re-lays out the whole page)
    const block = (e: Event) => { if (!(e.target as Element).closest('[data-booking-frame]')) e.preventDefault(); };
    sheet.addEventListener('wheel', block, { passive: false });
    sheet.addEventListener('touchmove', block, { passive: false });

    let animTimer: number | undefined;
    let iframeTimer: number | undefined;
    const animating = () => {
      sheet.classList.add('animating');
      clearTimeout(animTimer);
      animTimer = window.setTimeout(() => sheet.classList.remove('animating'), 650);
    };

    const close = () => {
      if (!sheet.classList.contains('open')) return;
      clearTimeout(iframeTimer);
      animating();
      sheet.classList.remove('open');
      if (panel) panel.style.transform = '';
      hideTimer = window.setTimeout(() => { sheet.hidden = true; }, 600);
      opener?.focus({ preventScroll: true });
    };
    sheet.querySelectorAll('[data-booking-close]').forEach((el) => el.addEventListener('click', close));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });

    // drag the handle down to dismiss
    const drag = sheet.querySelector<HTMLElement>('[data-booking-drag]');
    let startY = 0;
    let dragging = false;
    drag?.addEventListener('pointerdown', (e) => { dragging = true; sheet.classList.add('animating'); startY = e.clientY; drag.setPointerCapture(e.pointerId); panel?.classList.add('is-dragging'); });
    drag?.addEventListener('pointermove', (e) => { if (dragging && panel) panel.style.transform = `translateY(${Math.max(0, e.clientY - startY)}px)`; });
    const end = (e: PointerEvent) => {
      if (!dragging || !panel) return;
      dragging = false;
      panel.classList.remove('is-dragging');
      if (e.clientY - startY > 110) close();
      else panel.style.transform = '';
    };
    drag?.addEventListener('pointerup', end);
    drag?.addEventListener('pointercancel', end);

    const open = (url: string, from: HTMLElement) => {
      opener = from;
      clearTimeout(hideTimer);
      // Calendly is heavy: start it only once the slide has finished, so the animation keeps the main thread to itself
      const loadFrame = () => {
        if (!frame || loadedUrl === url) return;
        loadedUrl = url;
        frame.classList.remove('is-ready');
        frame.querySelector('iframe')?.remove();
        const src = new URL(url);
        src.searchParams.set('embed_domain', location.hostname || 'localhost');
        src.searchParams.set('embed_type', 'Inline');
        src.searchParams.set('hide_gdpr_banner', '1');
        const iframe = document.createElement('iframe');
        iframe.src = src.toString();
        iframe.title = 'Calendly scheduling';
        iframe.loading = 'eager';
        iframe.addEventListener('load', () => frame.classList.add('is-ready'));
        frame.appendChild(iframe);
      };
      sheet.hidden = false;
      animating();
      requestAnimationFrame(() => requestAnimationFrame(() => {
        sheet.classList.add('open');
        panel?.focus({ preventScroll: true });
        iframeTimer = window.setTimeout(loadFrame, 620);
      }));
    };
    bound.set(sheet, open);
    return open;
  }

  document.addEventListener('click', (e) => {
    const a = (e.target as Element | null)?.closest<HTMLAnchorElement>('[data-book-call]');
    if (!a || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
    const sheet = document.querySelector<HTMLElement>('[data-booking]');
    if (!sheet) return;
    e.preventDefault();
    (bound.get(sheet) ?? bind(sheet))(a.dataset.calendlyUrl ?? a.href, a);
  });
</script>

---
/** Round glass buttons with the LinkedIn and GitHub marks; on hover each fills with its brand colour. */
import { site } from '@config/site';
interface Props { size?: number; class?: string; labels?: boolean }
const { size = 40, class: cls, labels = false } = Astro.props;
const items = [
  { key: 'linkedin', label: 'LinkedIn', url: site.links.linkedin, path: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.75h3.96V21H3V9.75zm6.46 0h3.8v1.54h.05c.53-1 1.82-2.05 3.75-2.05 4.01 0 4.75 2.64 4.75 6.07V21h-3.96v-4.98c0-1.19-.02-2.72-1.66-2.72-1.66 0-1.92 1.3-1.92 2.63V21H9.46V9.75z' },
  { key: 'github', label: 'GitHub', url: site.links.github, path: 'M12 .5a11.5 11.5 0 0 0-3.64 22.42c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.29-1.69-1.29-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z' },
].filter((i) => i.url && !i.url.includes('TODO'));
---

<div class:list={['sb', labels && 'sb--labels', cls]} style={`--sb:${size}px`}>
  {items.map((i) => (
    <a class={`sb-btn sb-btn--${i.key}`} href={i.url} target="_blank" rel="noopener noreferrer" aria-label={`${i.label} profile of ${site.name} (opens in a new tab)`} title={i.label}>
      <span class="sb-ico" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d={i.path} /></svg></span>
      {labels && <span class="sb-l">{i.label}</span>}
    </a>
  ))}
</div>

<style>
  .sb { display: inline-flex; gap: 10px; align-items: center; }
  .sb-btn {
    display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: var(--fg);
    border-radius: var(--radius-full);
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .sb-ico {
    width: var(--sb); height: var(--sb); border-radius: 50%; display: grid; place-items: center; flex: none;
    background: linear-gradient(160deg, color-mix(in srgb, var(--fg) 14%, transparent), color-mix(in srgb, var(--fg) 4%, transparent));
    border: 1px solid var(--line-strong);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.18), 0 4px 14px rgba(0, 0, 0, 0.14);
    transition: background 0.35s ease, color 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
  }
  .sb-btn:hover { transform: translate3d(0, -2px, 0); }
  .sb-btn--linkedin:hover .sb-ico { background: linear-gradient(135deg, #0A66C2, #1D8CF8); color: #fff; border-color: transparent; box-shadow: 0 8px 22px rgba(10, 102, 194, 0.45); }
  .sb-btn--github:hover .sb-ico { background: linear-gradient(135deg, #24292F, #57606A); color: #fff; border-color: transparent; box-shadow: 0 8px 22px rgba(36, 41, 47, 0.45); }
  .sb-btn:focus-visible { outline: none; }
  .sb-btn:focus-visible .sb-ico { outline: 2px solid var(--accent); outline-offset: 3px; }

  /* with labels: pill buttons */
  .sb--labels .sb-btn { padding: 4px 16px 4px 4px; border: 1px solid var(--line); background: color-mix(in srgb, var(--fg) 3%, transparent); }
  .sb--labels .sb-l { font-family: var(--font-display); font-size: 10px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--fg-muted); transition: color 0.3s ease; }
  .sb--labels .sb-btn:hover .sb-l { color: var(--fg); }
  @media (prefers-reduced-motion: reduce) { .sb-btn, .sb-ico { transition: none; } }
</style>

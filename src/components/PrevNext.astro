---
/**
 * Previous / next navigation for detail pages, as two cinematic panels of identical size.
 * Each panel shows a preview image of its target (when one is given) behind a gradient, a small direction label,
 * the title, an optional meta line and an arrow that travels on hover; a hairline in the prism gradient draws
 * across the top edge. A slim "all" link sits under them.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Link from '@components/Link.astro';

interface Item { label: string; href: string; image?: ImageMetadata; meta?: string }
interface Props { prev?: Item; next?: Item; allHref: string; allLabel: string }
const { prev, next, allHref, allLabel } = Astro.props;
const sides = [
  { key: 'prev', item: prev, k: 'Previous', d: 'M19 12H5m6-6l-6 6 6 6' },
  { key: 'next', item: next, k: 'Next', d: 'M5 12h14m-6-6l6 6-6 6' },
] as const;
---

<nav class="pn-nav" aria-label="Previous and next">
  {sides.map(({ key, item, k, d }) => item ? (
    <Link href={item.href} class={`pn pn--${key}`} rel={key}>
      {item.image && <Image src={item.image} alt="" widths={[480, 800]} sizes="(max-width: 768px) 100vw, 520px" class="pn-img" loading="lazy" decoding="async" />}
      <span class="pn-veil" aria-hidden="true"></span>
      <span class="pn-line" aria-hidden="true"></span>
      <span class="pn-top">
        <span class="pn-k">{k}</span>
        <span class="pn-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={d} /></svg></span>
      </span>
      <span class="pn-body">
        <span class="pn-t">{item.label}</span>
        {item.meta && <span class="pn-m">{item.meta}</span>}
      </span>
    </Link>
  ) : <span class={`pn pn--empty pn--${key}`} aria-hidden="true"></span>)}

  <Link href={allHref} class="pn-all" aria-label={allLabel} title={allLabel}>
    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><rect x="4" y="4" width="6.5" height="6.5" rx="2" /><rect x="13.5" y="4" width="6.5" height="6.5" rx="2" /><rect x="4" y="13.5" width="6.5" height="6.5" rx="2" /><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="2" /></svg>
    <span>{allLabel}</span>
  </Link>
</nav>

<style>
  .pn-nav { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; margin-top: 96px; }

  .pn {
    position: relative; display: flex; flex-direction: column; justify-content: space-between; height: 210px; padding: 22px 24px;
    border-radius: 26px; overflow: hidden; text-decoration: none; color: var(--fg); isolation: isolate;
    background: color-mix(in srgb, var(--fg) 4%, transparent);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    transition: transform 0.7s var(--silk-ease), box-shadow 0.5s ease;
  }
  .pn--next { text-align: right; }
  .pn--empty { background: none; box-shadow: inset 0 0 0 1px var(--line); opacity: 0.5; }

  /* preview image: soft and desaturated at rest, comes alive on hover */
  :global(.pn-img) { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; object-position: top center; opacity: 0.34; filter: saturate(0.6); transform: scale(1.04); transition: opacity 0.6s ease, transform 1.2s var(--silk-ease), filter 0.6s ease; }
  .pn-veil { position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, var(--bg) 8%, color-mix(in srgb, var(--bg) 55%, transparent) 100%); }
  .pn--next .pn-veil { background: linear-gradient(270deg, var(--bg) 8%, color-mix(in srgb, var(--bg) 55%, transparent) 100%); }
  a.pn:hover :global(.pn-img) { opacity: 0.6; transform: scale(1.1); filter: saturate(1); }
  a.pn:hover { transform: translate3d(0, -4px, 0); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--fg) 26%, transparent), 0 30px 70px rgba(0, 0, 0, 0.25); }

  /* prism hairline draws across the top edge */
  .pn-line { position: absolute; left: 0; right: 0; top: 0; height: 2px; background: var(--prism); transform: scaleX(0); transform-origin: 0 50%; transition: transform 0.8s var(--silk-ease); }
  .pn--next .pn-line { transform-origin: 100% 50%; }
  a.pn:hover .pn-line, a.pn:focus-visible .pn-line { transform: scaleX(1); }
  a.pn:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }

  .pn-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .pn--prev .pn-top { flex-direction: row-reverse; }
  .pn-k { font-family: var(--font-display); font-size: 9.5px; font-weight: 600; letter-spacing: 0.3em; text-transform: uppercase; color: var(--fg-muted); }
  .pn-arrow { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; color: var(--fg); box-shadow: inset 0 0 0 1px var(--line-strong); transition: transform 0.7s var(--silk-ease), background 0.4s ease, color 0.4s ease, box-shadow 0.4s ease; }
  a.pn:hover .pn-arrow { background: var(--fg); color: var(--bg); box-shadow: none; }
  a.pn--prev:hover .pn-arrow { transform: translate3d(-6px, 0, 0); }
  a.pn--next:hover .pn-arrow { transform: translate3d(6px, 0, 0); }

  .pn-body { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .pn-t { font-family: var(--font-display); font-size: clamp(1.05rem, 1.7vw, 1.4rem); font-weight: 400; letter-spacing: -0.02em; line-height: 1.25; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden; }
  .pn-m { font-size: 0.8rem; color: var(--fg-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  /* all items: a quiet pill centred under the two panels */
  .pn-all {
    grid-column: 1 / -1; justify-self: center; margin-top: 12px;
    display: inline-flex; align-items: center; gap: 8px; padding: 12px 20px; border-radius: 100px; text-decoration: none; white-space: nowrap;
    font-family: var(--font-display); font-size: 9px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--fg-muted);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    transition: color 0.3s ease, transform 0.6s var(--silk-ease), box-shadow 0.3s ease;
  }
  .pn-all:hover { color: var(--fg); transform: translate3d(0, -2px, 0); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--fg) 30%, transparent); }

  @media (max-width: 768px) {
    .pn-nav { grid-template-columns: minmax(0, 1fr); gap: 12px; margin-top: 64px; }
    .pn { height: 150px; padding: 18px 20px; border-radius: 22px; }
    .pn--empty { display: none; }
    .pn-all { justify-self: stretch; justify-content: center; margin-top: 0; padding: 14px; }
  }
  @media (prefers-reduced-motion: reduce) { .pn, :global(.pn-img), .pn-line, .pn-arrow, .pn-all { transition: none; } }
</style>

---
/**
 * Circular brand mark (stylised portrait). Sizes are rendered through astro:assets.
 * `transitionName` enables the shared-element morph (nav mark ⇄ /about portrait).
 */
import { Image } from 'astro:assets';
import icon from '@assets/brand/logo-icon-800.png';
import { site } from '@config/site';
interface Props { size?: number; class?: string; transitionName?: string; priority?: boolean; glow?: boolean }
const { size = 32, class: cls, transitionName, priority = false, glow = false } = Astro.props;
const alt = `${site.name} — stylised portrait`;
---

<span class:list={['avatar', { 'avatar--glow': glow }, cls]} style={`--size:${size}px`} transition:name={transitionName}>
  <Image src={icon} alt={alt} width={size * 2} height={size * 2} densities={[1, 2]} format="webp" quality={82} loading={priority ? 'eager' : 'lazy'} decoding={priority ? 'sync' : 'async'} />
</span>

<style>
  .avatar { display: inline-block; width: var(--size); height: var(--size); border-radius: 50%; overflow: hidden; flex-shrink: 0; position: relative; }
  .avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .avatar--glow::before { content: ''; position: absolute; inset: -12%; border-radius: 50%; background: radial-gradient(circle, hsl(var(--tint-h) 70% 60% / 0.45), transparent 70%); filter: blur(18px); z-index: -1; }
</style>

---
/**
 * Mobile menu as an iOS bottom sheet (grab handle, slides up, staggered links). A plain CSS slide on the
 * compositor: no view-transition snapshot of the page and no live backdrop blur, so it stays smooth.
 * Behaviour ported from the Luminary mobile menu: opened by #navToggle, closes on
 * link click, Escape, backdrop tap and when the viewport grows past 1180px.
 */
import Link from '@components/Link.astro';
import GlassSlider from '@components/GlassSlider.astro';
import BookCall from '@components/BookCall.astro';
import { site } from '@config/site';
const links = [{ label: 'Home', href: '/' }, ...site.nav];
---

<div class="sheet" id="mobileMenu" role="dialog" aria-modal="true" aria-label={site.ui.menu} hidden>
  <div class="sheet-backdrop" data-sheet-close></div>
  <div class="sheet-panel" data-tint="freelance" data-sheet-panel>
    <div class="sheet-handle" aria-hidden="true"></div>
    <button class="sheet-close" type="button" data-sheet-close aria-label={site.ui.closeMenu}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
    <nav class="sheet-links" aria-label="Mobile">
      {links.map((n, i) => (
        <Link href={n.href} class="sheet-link" data-index={String(i + 1).padStart(2, '0')} activeMatch>{n.label}</Link>
      ))}
    </nav>
    <div class="sheet-book"><BookCall page="mobile-menu" size="sm" block disclosure="short" /></div>
    <div class="sheet-footer">
      {site.footerNav.map((n) => <Link href={n.href}>{n.label}</Link>)}
    </div>
    <div class="sheet-glass"><GlassSlider compact /></div>
  </div>
</div>

<style>
  .sheet { position: fixed; inset: 0; z-index: 550; }
  .sheet[hidden] { display: none; }
  .sheet-backdrop { position: absolute; inset: 0; background: rgba(0,0,0,0.45); opacity: 0; transition: opacity 0.45s ease; }
  .sheet-panel {
    position: absolute; left: 0; right: 0; bottom: 0;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0; border-bottom: 0;
    padding: 12px 24px calc(28px + env(safe-area-inset-bottom)); max-height: 88dvh; overflow-y: auto; overscroll-behavior: contain;
    transform: translate3d(0, 100%, 0); transition: transform 0.55s var(--silk-ease);
    /* the look of .glass--thick without a live backdrop blur: a blur re-sampled on every frame of the slide made it freeze */
    background:
      radial-gradient(120% 60% at 0% 0%, hsl(var(--tint-h) 70% 55% / 0.22), transparent 60%),
      radial-gradient(90% 60% at 100% 0%, hsl(calc(var(--tint-h) + 40) 70% 60% / 0.16), transparent 60%),
      color-mix(in srgb, var(--bg) 93%, hsl(var(--tint-h) 60% 50%));
    border: 1px solid var(--glass-border); border-bottom: 0;
    box-shadow: 0 -20px 60px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.16);
    contain: layout paint; backface-visibility: hidden;
  }
  .sheet.animating .sheet-panel { will-change: transform; }
  .sheet.open .sheet-backdrop { opacity: 1; }
  .sheet.open .sheet-panel { transform: translate3d(0, 0, 0); }
  .sheet-close { position: absolute; top: 14px; right: 16px; width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--line); background: var(--panel-bg); color: var(--fg); display: grid; place-items: center; cursor: pointer; }
  .sheet-handle { width: 40px; height: 5px; border-radius: 5px; background: var(--fg-subtle); opacity: 0.5; margin: 0 auto 20px; }
  .sheet-links { display: flex; flex-direction: column; }
  .sheet-link {
    display: flex; align-items: baseline; gap: 16px;
    font-family: var(--font-display); font-size: clamp(1.5rem, 5vw, 2.2rem); font-weight: 300; letter-spacing: -0.02em;
    color: var(--fg); text-decoration: none; padding: 12px 0; border-bottom: 1px solid var(--line);
    opacity: 0; transform: translate3d(0, 16px, 0); transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .sheet-link.active { font-weight: 600; }
  .sheet-link::before { content: attr(data-index); font-size: 10px; font-weight: 500; letter-spacing: 0.15em; color: var(--fg-subtle); opacity: 0.6; min-width: 24px; font-variant-numeric: tabular-nums; }
  .sheet.open .sheet-link { opacity: 1; transform: translateY(0); transition: opacity 0.5s var(--silk-ease), transform 0.5s var(--silk-ease); }
  .sheet.open .sheet-link:nth-child(1) { transition-delay: 0.06s; }
  .sheet.open .sheet-link:nth-child(2) { transition-delay: 0.12s; }
  .sheet.open .sheet-link:nth-child(3) { transition-delay: 0.18s; }
  .sheet.open .sheet-link:nth-child(4) { transition-delay: 0.24s; }
  .sheet.open .sheet-link:nth-child(5) { transition-delay: 0.30s; }
  .sheet.open .sheet-link:nth-child(6) { transition-delay: 0.36s; }
  .sheet.open .sheet-link:nth-child(7) { transition-delay: 0.42s; }
  .sheet.open .sheet-link:nth-child(8) { transition-delay: 0.48s; }
  .sheet-book { padding-top: 18px; opacity: 0; transition: opacity 0.3s ease; }
  .sheet.open .sheet-book { opacity: 1; transition: opacity 0.5s var(--silk-ease) 0.45s; }
  .sheet-footer { display: flex; flex-wrap: wrap; gap: 18px 24px; padding-top: 20px; opacity: 0; transition: opacity 0.3s ease; }
  .sheet.open .sheet-footer { opacity: 1; transition: opacity 0.5s var(--silk-ease) 0.5s; }
  .sheet-footer a { font-family: var(--font-display); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--fg-subtle); text-decoration: none; }
  .sheet-glass { display: flex; justify-content: center; padding-top: 18px; opacity: 0; transition: opacity 0.3s ease; }
  .sheet.open .sheet-glass { opacity: 1; transition: opacity 0.5s var(--silk-ease) 0.55s; }
</style>

<script>
  function init() {
    const sheet = document.getElementById('mobileMenu');
    const toggle = document.getElementById('navToggle');
    if (!sheet || !toggle || sheet.dataset.bound) return;
    sheet.dataset.bound = '';
    let open = false;
    let hideTimer: number | undefined;
    let animTimer: number | undefined;
    const animating = () => {
      sheet.classList.add('animating');
      clearTimeout(animTimer);
      animTimer = window.setTimeout(() => sheet.classList.remove('animating'), 600);
    };
    // keep the page from scrolling behind the sheet without toggling overflow (that re-lays out the whole page)
    const panel = sheet.querySelector<HTMLElement>('[data-sheet-panel]');
    sheet.addEventListener('wheel', (e) => { if (!panel?.contains(e.target as Node)) e.preventDefault(); }, { passive: false });
    sheet.addEventListener('touchmove', (e) => { if (!panel?.contains(e.target as Node)) e.preventDefault(); }, { passive: false });

    const openMenu = () => {
      if (open) return;
      open = true;
      clearTimeout(hideTimer);
      sheet.hidden = false;
      animating();
      toggle.classList.add('active');
      toggle.setAttribute('aria-expanded', 'true');
      requestAnimationFrame(() => requestAnimationFrame(() => {
        sheet.classList.add('open');
        document.body.classList.add('menu-open');
      }));
    };
    const closeMenu = () => {
      if (!open) return;
      open = false;
      animating();
      sheet.classList.remove('open');
      document.body.classList.remove('menu-open');
      toggle.classList.remove('active');
      toggle.setAttribute('aria-expanded', 'false');
      hideTimer = window.setTimeout(() => { sheet.hidden = true; }, 560);
    };
    toggle.addEventListener('click', () => (open ? closeMenu() : openMenu()));
    sheet.querySelectorAll('a, [data-sheet-close]').forEach((el) => el.addEventListener('click', closeMenu));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMenu(); });
    addEventListener('resize', () => { if (innerWidth > 1180) closeMenu(); }, { passive: true });
  }
  document.addEventListener('astro:page-load', init);
</script>

---
/**
 * Tinted-glass card. Renders as <a> when href is given (whole card clickable).
 *   variant: thin | regular | thick   tint: category key   spot/lift: interaction
 */
import type { HTMLAttributes } from 'astro/types';
import { withBase } from '@lib/url';

interface Props extends HTMLAttributes<'div'> {
  href?: string;
  variant?: 'thin' | 'regular' | 'thick';
  tint?: string;
  radius?: 'sm' | 'md' | 'lg';
  spot?: boolean;
  lift?: boolean;
  sheen?: boolean;
  padding?: 'sm' | 'md' | 'lg' | 'none';
  as?: 'div' | 'article' | 'li' | 'section' | 'blockquote';
}
const {
  href, variant = 'regular', tint, radius = 'md', spot = true, lift = true, sheen = true, padding = 'md',
  as = 'div', class: cls, ...rest
} = Astro.props;
const classes = [
  'glass', 'card',
  `card--pad-${padding}`,
  { 'glass--thin': variant === 'thin', 'glass--thick': variant === 'thick' },
  { 'glass--lg': radius === 'lg', 'glass--sm': radius === 'sm' },
  { 'glass--spot': spot, 'glass--lift': lift && (!!href || lift), 'glass--sheen': sheen },
  cls,
];
const Tag = href ? 'a' : as;
const external = href ? /^(https?:)?\/\//.test(href) : false;
---

<Tag
  class:list={classes}
  data-tint={tint}
  href={href ? withBase(href) : undefined}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  {...rest}
>
  <slot />
</Tag>

<style>
  .card { display: flex; flex-direction: column; text-decoration: none; color: inherit; }
  .card--pad-sm { padding: 20px 22px; }
  .card--pad-md { padding: 32px; }
  .card--pad-lg { padding: 44px 40px; }
  .card--pad-none { padding: 0; }
  @media (max-width: 768px) {
    .card--pad-md { padding: 24px; }
    .card--pad-lg { padding: 32px 26px; }
  }
</style>

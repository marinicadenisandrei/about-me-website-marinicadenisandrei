---
/**
 * Page loader for client-side navigation (ClientRouter): a minimal deploy pipeline.
 * If a navigation takes longer than SHOW_AFTER, an opaque cover hides the page; the page name is shown large
 * above a 4-step pipeline (Resolve, Fetch, Render, Deploy) on a single hairline, with the path and elapsed time.
 * Once shown it stays at least MIN_VISIBLE and plays the end of the pipeline, so it never flashes.
 * Persisted across navigations and kept above the view-transition snapshots. No backdrop-filter.
 */
const jobs = [
  { k: 'route', label: 'Resolve' },
  { k: 'fetch', label: 'Fetch' },
  { k: 'render', label: 'Render' },
  { k: 'ship', label: 'Deploy' },
];
---

<div class="pl" data-page-loader transition:persist="page-loader" aria-hidden="true">
  <div class="pl-cover"></div>

  <div class="pl-stage" role="status" aria-live="polite">
    <p class="pl-kicker"><span class="pl-pulse"></span><span data-pl-chip>Deploying</span></p>
    <p class="pl-title" data-pl-dest>Page</p>

    <ol class="pl-graph">
      {jobs.map((j) => (
        <li class="pl-job" data-pl-step={j.k}>
          <span class="pl-dot"><svg class="pl-check" viewBox="0 0 24 24" width="9" height="9" fill="none" stroke="currentColor" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></span>
          <span class="pl-jname">{j.label}</span>
        </li>
      ))}
      <span class="pl-rail" aria-hidden="true"><span class="pl-rail-fill" data-pl-fill></span></span>
    </ol>

    <p class="pl-foot"><span data-pl-path>/</span><span class="pl-sep"></span><span data-pl-elapsed>0.0s</span></p>
  </div>
</div>

<style is:global>
  .pl { position: fixed; inset: 0; z-index: 800; display: grid; place-items: center; padding: 24px; pointer-events: none; opacity: 0; visibility: hidden; transition: opacity 0.4s ease, visibility 0s linear 0.4s; view-transition-name: page-loader; }
  .pl.is-on { opacity: 1; visibility: visible; pointer-events: auto; transition: opacity 0.2s ease, visibility 0s; }
  ::view-transition-group(page-loader) { z-index: 1000; animation: none; }
  ::view-transition-old(page-loader) { display: none; }
  ::view-transition-new(page-loader) { animation: none; }

  /* opaque cover: nothing of the page shows while loading */
  .pl-cover { position: absolute; inset: 0; background: radial-gradient(70% 60% at 50% 45%, color-mix(in srgb, var(--bg) 92%, hsl(var(--tint-h) 60% 55%)), var(--bg)); }

  .pl-stage {
    position: relative; width: min(420px, 100%); display: flex; flex-direction: column; align-items: center; text-align: center;
    opacity: 0; transform: translate3d(0, 10px, 0); transition: opacity 0.2s ease, transform 0.3s ease;
  }
  .pl.is-on .pl-stage { opacity: 1; transform: none; transition: opacity 0.4s ease 0.05s, transform 0.6s var(--silk-ease) 0.05s; }

  .pl-kicker { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 10px; font-family: var(--font-ui); font-size: 12px; font-weight: 500; letter-spacing: 0.01em; color: var(--fg-subtle); }
  .pl-pulse { width: 6px; height: 6px; border-radius: 50%; background: #F59E0B; box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.5); animation: pl-ping 1.4s ease-out infinite; animation-play-state: paused; }
  .pl.is-on .pl-pulse { animation-play-state: running; }
  .pl.is-done .pl-pulse { background: #10B981; animation: none; }
  .pl-title { margin: 0; max-width: 100%; font-family: var(--font-ui); font-size: clamp(1.6rem, 4vw, 2.1rem); font-weight: 600; letter-spacing: -0.025em; line-height: 1.15; color: var(--fg); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  /* 4-step pipeline on one hairline */
  .pl-graph { position: relative; list-style: none; width: 100%; margin: 34px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .pl-rail { position: absolute; top: 8px; left: 12.5%; right: 12.5%; height: 1.5px; border-radius: 2px; background: color-mix(in srgb, var(--fg) 12%, transparent); overflow: hidden; z-index: 0; }
  .pl-rail-fill { position: absolute; inset: 0; transform-origin: 0 50%; transform: scaleX(0); background: linear-gradient(90deg, #10B981, #34D399); transition: transform 0.45s var(--silk-ease); }
  .pl-job { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .pl-dot {
    position: relative; width: 17px; height: 17px; border-radius: 50%; display: grid; place-items: center; color: #fff;
    background: var(--bg); border: 1.5px solid color-mix(in srgb, var(--fg) 22%, transparent);
    transition: background 0.3s ease, border-color 0.3s ease, transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .pl-dot::after { content: ''; position: absolute; inset: -5px; border-radius: 50%; border: 1.5px solid transparent; border-top-color: #F59E0B; opacity: 0; animation: pl-spin 0.8s linear infinite; animation-play-state: paused; }
  .pl-check { opacity: 0; transform: scale(0.4); transition: opacity 0.2s ease, transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .pl-jname { font-family: var(--font-ui); font-size: 11.5px; font-weight: 500; color: var(--fg-subtle); transition: color 0.3s ease; }
  .pl-job.is-active .pl-dot { border-color: #F59E0B; }
  .pl-job.is-active .pl-dot::after { opacity: 1; animation-play-state: running; }
  .pl-job.is-active .pl-jname { color: var(--fg); }
  .pl-job.is-done .pl-dot { background: #10B981; border-color: #10B981; transform: scale(1.06); }
  .pl-job.is-done .pl-check { opacity: 1; transform: none; }
  .pl-job.is-done .pl-jname { color: var(--fg-muted); }

  .pl-foot { display: inline-flex; align-items: center; gap: 10px; margin: 30px 0 0; font-family: var(--font-mono); font-size: 11px; color: var(--fg-subtle); font-variant-numeric: tabular-nums; }
  .pl-sep { width: 3px; height: 3px; border-radius: 50%; background: currentColor; opacity: 0.6; }

  @keyframes pl-spin { to { transform: rotate(360deg); } }
  @keyframes pl-ping { 0% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.5); } 80%, 100% { box-shadow: 0 0 0 7px rgba(245, 158, 11, 0); } }
  @media (prefers-reduced-motion: reduce) {
    .pl-dot::after, .pl-pulse { animation: none; }
    .pl-stage, .pl.is-on .pl-stage { transform: none; }
  }
</style>

<script>
  /** Runs once (the element is persisted); drives the loader from the ClientRouter lifecycle events. */
  const SHOW_AFTER = 160;   // instant navigations never show the loader
  const MIN_VISIBLE = 700;  // once shown, stay long enough to read, never flash
  const NAMES: Record<string, string> = {
    '': 'Home', about: 'About', projects: 'Projects', stack: 'Stack', learning: 'Learning', contact: 'Contact', services: 'Services',
    cv: 'CV', legal: 'Legal', research: 'Research & Teaching', teaching: 'Teaching', experience: 'Experience', privacy: 'Privacy', cookies: 'Cookies',
  };

  const segs = (url: URL) => {
    const base = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');
    return url.pathname.replace(base, '').split('/').filter(Boolean).map(decodeURIComponent);
  };
  const titleFromPath = (url: URL) => {
    const p = segs(url);
    const last = p[p.length - 1] ?? '';
    const known = NAMES[last];
    if (known) return known;
    const words = last.split('-').filter(Boolean);
    if (words.length === 1 && last.length <= 6) return last.toUpperCase();
    return words.map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
  };
  const titleFromSource = (el: Element | undefined) => {
    const a = el?.closest?.('a');
    if (!a) return '';
    const label = a.querySelector('h2, h3, h4, .pn-t')?.textContent || a.getAttribute('aria-label') || a.textContent || '';
    const clean = label.replace(/\s+/g, ' ').trim();
    return clean.length > 0 && clean.length <= 48 ? clean : '';
  };

  type K = 'route' | 'fetch' | 'render' | 'ship';
  const root = () => document.querySelector<HTMLElement>('[data-page-loader]');
  let timers: number[] = [];
  let tick: number | undefined;
  let shownAt = 0;
  let t0 = 0;
  let last = 0;
  let active = false;
  let loaded = false;
  const later = (fn: () => void, wait: number) => { timers.push(window.setTimeout(fn, wait)); };
  const clear = () => { timers.forEach(clearTimeout); timers = []; clearInterval(tick); };
  const dur = (v: number) => (v < 1000 ? `${Math.max(1, Math.round(v))}ms` : `${(v / 1000).toFixed(1)}s`);

  function set(el: HTMLElement, k: K, state: 'active' | 'done') {
    const job = el.querySelector<HTMLElement>(`[data-pl-step="${k}"]`);
    const line = el.querySelector<HTMLElement>(`[data-pl-line="${k}"]`);
    if (state === 'done' && job?.classList.contains('is-done')) return;
    for (const n of [job, line]) { if (!n) continue; n.classList.toggle('is-active', state === 'active'); n.classList.toggle('is-done', state === 'done'); }
    const now = performance.now();
    const done = el.querySelectorAll('.pl-job.is-done').length;
    const f = el.querySelector<HTMLElement>('[data-pl-fill]'); if (f) f.style.transform = `scaleX(${Math.min(1, Math.max(0, (done - 1) / 3 + (state === 'active' ? 1 / 6 : 0)))})`;
    if (state === 'done') {
      const d = dur(now - (last || t0));
      const t = job?.querySelector('[data-pl-time]'); if (t) t.textContent = d;
      const lt = line?.querySelector('[data-pl-ltime]'); if (lt) lt.textContent = d;
    }
    last = now;
  }

  function reset(el: HTMLElement, dest: string, path: string) {
    el.classList.remove('is-on', 'is-done');
    el.querySelectorAll<HTMLElement>('[data-pl-step], [data-pl-line]').forEach((n) => n.classList.remove('is-active', 'is-done'));
    el.querySelectorAll('[data-pl-time], [data-pl-ltime]').forEach((n) => { n.textContent = ''; });
    const txt = (sel: string, v: string) => { const n = el.querySelector(sel); if (n) n.textContent = v; };
    txt('[data-pl-dest]', dest || 'Page');
    txt('[data-pl-path]', path);
    txt('[data-pl-chip]', 'Deploying');
    const rf = el.querySelector<HTMLElement>('[data-pl-fill]'); if (rf) rf.style.transform = 'scaleX(0)';
    txt('[data-pl-elapsed]', '0.0s');
  }

  function start(dest: string, path: string) {
    const el = root();
    if (!el) return;
    clear();
    active = true; loaded = false; shownAt = 0; t0 = performance.now(); last = t0;
    reset(el, dest, path);
    later(() => {
      if (!active) return;
      el.classList.add('is-on');
      shownAt = performance.now();
      set(el, 'route', 'done'); set(el, 'fetch', 'active');
      const e = el.querySelector('[data-pl-elapsed]');
      tick = window.setInterval(() => { if (e) e.textContent = `${((performance.now() - t0) / 1000).toFixed(1)}s`; }, 100);
      if (loaded) set(el, 'fetch', 'done');
    }, SHOW_AFTER);
  }

  function finish() {
    if (!active) return;
    const el = root();
    if (!el) return;
    if (!shownAt) { active = false; clear(); return; } // fast: never shown
    const wait = Math.max(0, MIN_VISIBLE - (performance.now() - shownAt));
    later(() => { set(el, 'fetch', 'done'); set(el, 'render', 'active'); }, wait);
    later(() => { set(el, 'render', 'done'); set(el, 'ship', 'active'); }, wait + 180);
    later(() => {
      set(el, 'ship', 'done');
      clearInterval(tick);
      el.classList.add('is-done');
      const c = el.querySelector('[data-pl-chip]'); if (c) c.textContent = 'Deployed';
    }, wait + 360);
    later(() => { el.classList.remove('is-on'); active = false; }, wait + 760);
  }

  document.addEventListener('astro:before-preparation', (e) => {
    const ev = e as Event & { to: URL; from: URL; sourceElement?: Element };
    if (ev.to.pathname === ev.from.pathname) return; // hash links on the same page
    const s = segs(ev.to);
    start(titleFromSource(ev.sourceElement) || titleFromPath(ev.to), `/${s.join('/')}`);
  });
  document.addEventListener('astro:after-preparation', () => { loaded = true; const el = root(); if (el && active && shownAt) set(el, 'fetch', 'done'); });
  // while the loader covers the screen, swap pages directly (no slide), so the loader reveals the finished page
  document.addEventListener('astro:before-swap', (e) => {
    if (!active || !shownAt) return;
    (e as Event & { viewTransition?: ViewTransition }).viewTransition?.skipTransition();
  });
  document.addEventListener('astro:page-load', finish);
  // bfcache restore or a failed fetch that falls back to a full load
  window.addEventListener('pageshow', () => { const el = root(); clear(); active = false; el?.classList.remove('is-on', 'is-done'); });
</script>

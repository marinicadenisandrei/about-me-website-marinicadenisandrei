---
/**
 * Page loader for client-side navigation (ClientRouter).
 * Fast navigations show nothing. After 120 ms a thin Safari-style progress bar runs along the top edge;
 * after 450 ms a small tinted-glass card appears in the middle with the DM monogram, a rotating light ring
 * and the name of the page being opened. Both go away as soon as the new page is ready.
 * Persisted across navigations so its state survives the swap. No backdrop-filter (nothing blurs under the motion),
 * only transform/opacity animate, and it never blocks clicks.
 */
---

<div class="pl" data-page-loader transition:persist="page-loader" aria-hidden="true">
  <div class="pl-bar"><span class="pl-bar-fill"></span></div>
  <div class="pl-scrim"></div>
  <div class="pl-hud" role="status" aria-live="polite">
    <div class="pl-mark">
      <span class="pl-ring"></span>
      <span class="pl-tile">DM</span>
    </div>
    <div class="pl-text">
      <span class="pl-tag">Opening</span>
      <span class="pl-dest" data-page-loader-dest>Page</span>
    </div>
    <span class="pl-spinner">{Array.from({ length: 8 }, (_, i) => <i style={`--i:${i}`}></i>)}</span>
    <span class="pl-track"><span class="pl-track-fill"></span></span>
  </div>
</div>

<style is:global>
  .pl { position: fixed; inset: 0; z-index: 800; pointer-events: none; }

  /* top progress bar */
  .pl-bar { position: absolute; top: 0; left: 0; right: 0; height: 3px; opacity: 0; transition: opacity 0.35s ease 0.1s; }
  .pl-bar-fill {
    position: absolute; inset: 0; transform-origin: 0 50%; transform: scaleX(0);
    background: linear-gradient(90deg, hsl(var(--tint-h) 80% 62%), hsl(calc(var(--tint-h) + 50) 80% 66%), hsl(calc(var(--tint-h) + 110) 70% 62%));
    box-shadow: 0 0 12px hsl(var(--tint-h) 80% 60% / 0.7);
    border-radius: 0 3px 3px 0;
  }
  .pl.is-bar .pl-bar { opacity: 1; transition-delay: 0s; }
  /* trickles towards 90 % while waiting, like Safari */
  .pl.is-bar .pl-bar-fill { transform: scaleX(0.9); transition: transform 8s cubic-bezier(0.08, 0.7, 0.2, 1); }
  .pl.is-done .pl-bar-fill { transform: scaleX(1); transition: transform 0.25s ease-out; }

  /* soft dim, no blur */
  .pl-scrim { position: absolute; inset: 0; background: color-mix(in srgb, var(--bg) 52%, transparent); opacity: 0; transition: opacity 0.35s ease; }
  .pl.is-hud .pl-scrim { opacity: 1; }

  /* centre card */
  .pl-hud {
    position: absolute; left: 50%; top: 50%;
    display: flex; align-items: center; gap: 16px;
    width: min(340px, calc(100vw - 40px)); padding: 16px 22px 16px 16px;
    border-radius: 26px;
    background:
      radial-gradient(120% 90% at 0% 0%, hsl(var(--tint-h) 70% 55% / 0.24), transparent 60%),
      radial-gradient(90% 90% at 100% 100%, hsl(calc(var(--tint-h) + 60) 70% 60% / 0.16), transparent 60%),
      color-mix(in srgb, var(--bg) 92%, hsl(var(--tint-h) 60% 50%));
    border: 1px solid var(--glass-border, rgba(255, 255, 255, 0.14));
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35), 0 2px 8px rgba(0, 0, 0, 0.15), inset 0 1px 0 rgba(255, 255, 255, 0.18);
    opacity: 0; transform: translate3d(-50%, calc(-50% + 14px), 0) scale(0.94);
    transition: opacity 0.25s ease, transform 0.3s ease;
    overflow: hidden;
  }
  .pl.is-hud .pl-hud {
    opacity: 1; transform: translate3d(-50%, -50%, 0) scale(1);
    transition: opacity 0.4s var(--silk-ease), transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* monogram with a rotating light ring */
  .pl-mark { position: relative; flex: none; width: 56px; height: 56px; display: grid; place-items: center; }
  .pl-ring {
    position: absolute; inset: 0; border-radius: 19px; padding: 2.5px; overflow: hidden;
    /* keep only a 2px ring: the spinning gradient below shows through it */
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
    background: color-mix(in srgb, var(--fg) 10%, transparent);
  }
  .pl-ring::before {
    /* only a cheap transform animates */
    content: ''; position: absolute; inset: -30%;
    background: conic-gradient(from 0deg, transparent 0deg, hsl(var(--tint-h) 85% 65%) 80deg, hsl(calc(var(--tint-h) + 70) 85% 72%) 150deg, transparent 210deg, transparent 360deg);
    animation: pl-spin 1.1s linear infinite; animation-play-state: paused;
  }
  .pl.is-hud .pl-ring::before { animation-play-state: running; }
  .pl-tile {
    position: relative; width: 48px; height: 48px; border-radius: 15px;
    display: grid; place-items: center;
    font-family: var(--font-display); font-weight: 600; font-size: 16px; letter-spacing: 0.02em; color: var(--fg);
    background: linear-gradient(160deg, color-mix(in srgb, var(--fg) 14%, transparent), color-mix(in srgb, var(--fg) 4%, transparent));
    box-shadow: 0 0 22px hsl(var(--tint-h) 80% 60% / 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.2), inset 0 0 0 1px color-mix(in srgb, var(--fg) 10%, transparent);
  }

  /* iOS activity indicator */
  .pl-spinner { position: relative; flex: none; margin-left: auto; width: 22px; height: 22px; }
  .pl-spinner i { position: absolute; left: 9.75px; top: 0; width: 2.5px; height: 6.5px; border-radius: 2px; background: var(--fg-muted); transform-origin: 1.25px 11px; transform: rotate(calc(var(--i) * 45deg)); opacity: 0.25; animation: pl-fade 0.8s linear infinite; animation-delay: calc(var(--i) * 0.1s - 0.8s); animation-play-state: paused; }
  .pl.is-hud .pl-spinner i { animation-play-state: running; }

  .pl-text { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .pl-tag { font-family: var(--font-display); font-size: 9.5px; font-weight: 600; letter-spacing: 0.26em; text-transform: uppercase; color: hsl(var(--tint-h) 70% 64%); }
  .pl-dest { font-family: var(--font-display); font-size: 1.05rem; font-weight: 500; letter-spacing: -0.01em; color: var(--fg); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 60vw; }

  /* indeterminate hairline along the bottom of the card */
  .pl-track { position: absolute; left: 18px; right: 18px; bottom: 0; height: 2px; overflow: hidden; border-radius: 2px; }
  .pl-track-fill {
    position: absolute; inset: 0; width: 40%;
    background: linear-gradient(90deg, transparent, hsl(var(--tint-h) 85% 66%), transparent);
    animation: pl-sweep 1.3s cubic-bezier(0.45, 0, 0.55, 1) infinite; animation-play-state: paused;
  }
  .pl.is-hud .pl-track-fill { animation-play-state: running; }

  @keyframes pl-fade { from { opacity: 1; } to { opacity: 0.2; } }
  @keyframes pl-spin { to { transform: rotate(360deg); } }
  @keyframes pl-sweep { from { transform: translate3d(-100%, 0, 0); } to { transform: translate3d(250%, 0, 0); } }

  @media (prefers-reduced-motion: reduce) {
    .pl-ring::before, .pl-track-fill, .pl-spinner i { animation: none; }
    .pl-hud, .pl.is-hud .pl-hud { transition: opacity 0.2s ease; }
  }
</style>

<script>
  /** Runs once (the element is persisted); drives the loader from the ClientRouter lifecycle events. */
  const BAR_AFTER = 120;
  const HUD_AFTER = 450;
  const NAMES: Record<string, string> = {
    '': 'Home', about: 'About', projects: 'Projects', stack: 'Stack', learning: 'Learning', contact: 'Contact', services: 'Services',
    cv: 'CV', legal: 'Legal', research: 'Research', teaching: 'Teaching', experience: 'Experience', privacy: 'Privacy',
  };

  const titleFromPath = (url: URL) => {
    const base = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');
    const parts = url.pathname.replace(base, '').split('/').filter(Boolean);
    const last = decodeURIComponent(parts[parts.length - 1] ?? '');
    const known = NAMES[last];
    if (known) return known;
    const words = last.split('-').filter(Boolean);
    if (words.length === 1 && last.length <= 6) return last.toUpperCase();
    return words.map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
  };

  const titleFromSource = (el: Element | undefined) => {
    const a = el?.closest?.('a');
    if (!a) return '';
    const label = a.getAttribute('aria-label') || a.querySelector('h2, h3, h4')?.textContent || a.textContent || '';
    const clean = label.replace(/\s+/g, ' ').trim();
    return clean.length > 0 && clean.length <= 42 ? clean : '';
  };

  let barTimer: number | undefined;
  let hudTimer: number | undefined;
  let endTimer: number | undefined;
  let active = false;

  const root = () => document.querySelector<HTMLElement>('[data-page-loader]');

  const start = (dest: string) => {
    const el = root();
    if (!el) return;
    clearTimeout(barTimer); clearTimeout(hudTimer); clearTimeout(endTimer);
    el.classList.remove('is-done', 'is-bar', 'is-hud');
    const d = el.querySelector('[data-page-loader-dest]');
    if (d) d.textContent = dest || 'Page';
    active = true;
    barTimer = window.setTimeout(() => { if (active) el.classList.add('is-bar'); }, BAR_AFTER);
    hudTimer = window.setTimeout(() => { if (active) el.classList.add('is-hud'); }, HUD_AFTER);
  };

  const finish = () => {
    if (!active) return;
    active = false;
    clearTimeout(barTimer); clearTimeout(hudTimer);
    const el = root();
    if (!el) return;
    if (!el.classList.contains('is-bar')) { el.classList.remove('is-hud'); return; }
    el.classList.add('is-done');
    el.classList.remove('is-hud');
    endTimer = window.setTimeout(() => el.classList.remove('is-bar', 'is-done'), 380);
  };

  document.addEventListener('astro:before-preparation', (e) => {
    const ev = e as Event & { to: URL; from: URL; sourceElement?: Element };
    if (ev.to.pathname === ev.from.pathname) return; // hash links on the same page
    start(titleFromSource(ev.sourceElement) || titleFromPath(ev.to));
  });
  document.addEventListener('astro:after-preparation', finish);
  document.addEventListener('astro:page-load', finish);
  // bfcache restore or a failed fetch that falls back to a full load
  window.addEventListener('pageshow', finish);
</script>

---
/**
 * Luminary hero: badge (pulsing dot), h1 with gradient <em>, sub, CTAs, animated
 * metrics, and the mouse-following spotlight grid. Metrics are computed from content.
 */
import Link from '@components/Link.astro';
import CvLinks from '@components/CvLinks.astro';
import { site } from '@config/site';
import HeroPortrait from '@components/HeroPortrait.astro';
import { getHeroMetrics } from '@lib/content';

interface Props { title?: string; sub?: string; compact?: boolean; portrait?: boolean }
const { title = site.ui.heroTitle, sub = site.tagline, compact = false, portrait = !compact } = Astro.props;
const m = await getHeroMetrics();
/** Wrap each word in <span class="word" style="--w:i"> so the headline rises word by word; <em> boundaries are preserved. */
function splitWords(html: string): string {
  let i = 0;
  return html.replace(/(<em>|<\/em>|<strong>|<\/strong>)|([^\s<]+)/g, (mt, tag, word) => (tag ? tag : `<span class="word" style="--w:${i++}">${word}</span>`));
}
const titleHtml = splitWords(title);
const metrics = [
  { value: m.years, suffix: '+', label: site.ui.metrics.yearsExperience },
  { value: m.projects, suffix: '', label: site.ui.metrics.projects },
  { value: m.learningHours, suffix: 'h', label: site.ui.metrics.learningHours },
  // Rule: entries in `certifications` with kind ≠ skill-assessment + course certificates not already listed there (see countCertifications in src/lib/content.ts)
  { value: m.certifications, suffix: '', label: site.ui.metrics.certifications },
];
---

<section class:list={['hero', { compact, 'has-portrait': portrait }]} id="hero" data-label="Home">
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-content">
  {site.availableForFreelance && (
    <div class="hero-badge glass glass--thin glass--pill" data-tint="freelance">
      <div class="hero-badge-dot"></div>
      <span>{site.ui.heroBadge}</span>
    </div>
  )}
  <p class="hero-kicker">{site.headline}</p>
  <h1 set:html={titleHtml} />
  <p class="hero-sub">{sub}</p>
  <div class="hero-ctas">
    <Link href="/services" class="btn btn--primary">{site.ui.ctaWorkWithMe}</Link>
    <CvLinks />
  </div>
  {!compact && (
    <div class="hero-metrics">
      {metrics.map((x) => (
        <div class="metric">
          <div class="metric-value"><span class="counter" data-target={x.value} data-decimals="0">0</span><span>{x.suffix}</span></div>
          <div class="metric-label">{x.label}</div>
        </div>
      ))}
    </div>
  )}
  </div>
  {portrait && <div class="hero-side"><HeroPortrait /></div>}
</section>

<style>
  .hero { min-height: calc(100vh / var(--zoom, 1)); display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 140px 0 80px; position: relative; }
  .hero.compact { min-height: 70vh; }
  .hero-content { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .hero.has-portrait { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: 48px; align-items: center; text-align: left; }
  .hero.has-portrait .hero-content { align-items: flex-start; text-align: left; }
  .hero.has-portrait h1 { max-width: 15ch; font-size: clamp(2.4rem, 4.8vw, 4.4rem); }
  .hero.has-portrait .hero-sub { margin-left: 0; margin-right: 0; }
  .hero.has-portrait .hero-kicker { max-width: 560px; }
  .hero.has-portrait .hero-metrics { justify-content: flex-start; gap: 40px; }
  .hero-side { position: relative; z-index: 1; }
  .hero-grid {
    position: absolute; bottom: 0; left: 50%; height: 80%; width: calc(100vw / var(--zoom, 1)); transform: translateX(-50%); z-index: 0; pointer-events: none;
    --mx: 50%; --my: 50%;
    background-image: linear-gradient(to right, var(--grid-line) 1px, transparent 1px), linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    background-size: 120px 120px; background-position: center bottom;
    -webkit-mask-image: radial-gradient(circle 300px at var(--mx) var(--my), rgba(0,0,0,1) 0%, transparent 65%), linear-gradient(to bottom, transparent 0%, transparent 25%, rgba(0,0,0,0.1) 45%, rgba(0,0,0,0.25) 70%, rgba(0,0,0,0.4) 100%);
    mask-image: radial-gradient(circle 300px at var(--mx) var(--my), rgba(0,0,0,1) 0%, transparent 65%), linear-gradient(to bottom, transparent 0%, transparent 25%, rgba(0,0,0,0.1) 45%, rgba(0,0,0,0.25) 70%, rgba(0,0,0,0.4) 100%);
    -webkit-mask-composite: source-over; mask-composite: add;
  }
  .hero > :global(*:not(.hero-grid)) { position: relative; z-index: 1; }
  .hero-badge { display: inline-flex; align-items: center; gap: 10px; padding: 10px 22px; margin-bottom: 36px; opacity: 0; transform: translateY(16px); animation: fadeUp 1.2s var(--silk-ease) 0.2s forwards; }
  .hero-badge-dot { width: 6px; height: 6px; border-radius: 50%; background: hsl(var(--tint-h) 70% 60%); box-shadow: 0 0 8px hsl(var(--tint-h) 70% 60% / 0.6); animation: pulse 3s ease-in-out infinite; }
  .hero-badge span { font-family: var(--font-display); font-size: 10px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--fg-muted); }
  .hero-kicker { font-family: var(--font-display); font-size: 10px; font-weight: 500; letter-spacing: 0.22em; text-transform: uppercase; color: var(--fg-subtle); max-width: 760px; line-height: 1.9; margin-bottom: 22px; opacity: 0; animation: fadeUp 1.2s var(--silk-ease) 0.3s forwards; }
  .hero h1 { font-size: clamp(2.6rem, 6.5vw, 5.4rem); font-weight: 300; letter-spacing: -0.05em; line-height: 1.02; max-width: 16ch; }
  .hero h1 { --em-grad: linear-gradient(135deg, var(--fg), hsl(var(--tint-h) 70% var(--em-l1)), hsl(calc(var(--tint-h) + 40) 60% var(--em-l2))); }
  .hero h1 :global(em) { font-style: normal; font-weight: 600; }
  /* gradient text: on the <em> itself (no-JS / reduced motion) and on each word span (inline-block boxes don't inherit a parent's clipped background) */
  .hero h1 :global(em), .hero h1 :global(em .word) { background: var(--em-grad); background-size: 200% 100%; -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .hero-sub { font-size: clamp(0.9rem, 1.2vw, 1.05rem); font-weight: 300; line-height: 1.7; color: var(--fg-muted); max-width: 520px; margin: 28px auto 44px; opacity: 0; transform: translateY(16px); animation: fadeUp 1.4s var(--silk-ease) 0.6s forwards; }
  .hero-ctas { display: flex; gap: 14px; opacity: 0; transform: translateY(16px); animation: fadeUp 1.4s var(--silk-ease) 0.8s forwards; }
  .hero-metrics { display: flex; justify-content: center; gap: 56px; margin-top: 72px; opacity: 0; transform: translateY(16px); animation: fadeUp 1.4s var(--silk-ease) 1s forwards; }
  .metric { text-align: center; }
  .metric-value { font-family: var(--font-display); font-size: clamp(1.8rem, 3vw, 2.6rem); font-weight: 300; letter-spacing: -0.04em; color: var(--fg); line-height: 1; font-variant-numeric: tabular-nums; }
  .metric-value span:last-child { font-size: 0.5em; font-weight: 400; color: var(--fg-subtle); vertical-align: super; margin-left: 2px; }
  .metric-label { font-family: var(--font-display); font-size: 9px; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: var(--fg-subtle); margin-top: 8px; }
  @keyframes fadeUp { to { opacity: 1; transform: translateY(0); } }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
  @media (prefers-reduced-motion: reduce) {
    .hero-badge, .hero-kicker, .hero-sub, .hero-ctas, .hero-metrics { opacity: 1; transform: none; animation: none; }
    .hero-badge-dot { animation: none; }
  }
  @media (max-width: 1024px) {
    .hero.has-portrait { grid-template-columns: minmax(0, 1fr); gap: 8px; text-align: center; }
    .hero.has-portrait .hero-content { align-items: center; text-align: center; order: 2; }
    .hero.has-portrait .hero-side { order: 1; width: min(300px, 70vw); margin: 0 auto; }
    .hero.has-portrait .hero-metrics { justify-content: center; }
    .hero.has-portrait .hero-sub { margin-left: auto; margin-right: auto; }
  }
  @media (max-width: 768px) {
    .hero { min-height: 100svh; padding: 120px 0 60px; }
    .hero-metrics { flex-wrap: wrap; gap: 28px 40px; }
    .hero-ctas { flex-direction: column; align-items: center; width: 100%; }
    .hero-ctas :global(.btn) { width: 100%; max-width: 300px; }
  }
</style>

<script>
  import { initHeroGrid } from '@/scripts/spotlight';
  import { initCounters } from '@/scripts/counter';
  document.addEventListener('astro:page-load', () => {
    const hero = document.getElementById('hero');
    const grid = hero?.querySelector<HTMLElement>('.hero-grid');
    if (hero && grid) initHeroGrid(hero, grid);
    initCounters();
  });
</script>

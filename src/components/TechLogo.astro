---
/**
 * Technology logo: transparent PNG generated by `npm run logos` into public/tech/.
 * Logos with a lot of dark ink also get a light version for dark mode (public/tech/dark/); CSS shows the right one.
 * Decorative: the label sits next to it.
 */
import { canonicalTech } from '@config/stack';
import { withBase } from '@lib/url';
import manifest from '@config/tech-logos.json';
interface Props { slug: string; size?: number; class?: string; eager?: boolean }
const { slug, size = 16, class: cls, eager = false } = Astro.props;
const key = canonicalTech(slug);
const has = manifest.logos.includes(key);
const hasDark = manifest.dark.includes(key);
/** Pills and other small sizes use the 48 px files; cards and headers the 128 px ones. */
const dir = size <= 24 ? '/tech/sm' : '/tech';
const loading = eager ? 'eager' : 'lazy';
---

{has && <img class:list={['tech-logo', { 'tech-logo--light': hasDark }, cls]} src={withBase(`${dir}/${key}.png`)} width={size} height={size} alt="" aria-hidden="true" loading={loading} decoding="async" />}
{hasDark && <img class:list={['tech-logo', 'tech-logo--dark', cls]} src={withBase(`${dir}/dark/${key}.png`)} width={size} height={size} alt="" aria-hidden="true" loading={loading} decoding="async" />}

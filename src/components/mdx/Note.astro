---
/** Callout used inside project MDX pages. Styled fully in stage 3 (glass). */
interface Props { title?: string }
const { title } = Astro.props;
---
<aside class="note" role="note">
  {title && <strong>{title}</strong>}
  <slot />
</aside>
<style>
  .note { border: 1px solid var(--panel-border); border-radius: var(--radius-sm); padding: 16px 20px; background: var(--panel-bg); margin: 24px 0; }
  .note strong { display: block; font-family: var(--font-display); font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--slate-warm); margin-bottom: 8px; }
</style>

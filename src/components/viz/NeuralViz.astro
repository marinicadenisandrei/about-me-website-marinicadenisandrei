---
/** Role 02 (academia): a neural network with signals flowing through it, a training curve and the courses I teach. */
import VizFrame from './VizFrame.astro';

interface Props { courses?: { name: string; level: string }[] }
const { courses = [] } = Astro.props;

const W = 340;
const H = 190;
const layers = [3, 5, 5, 2];
const xs = layers.map((_, i) => 34 + (i * (W - 68)) / (layers.length - 1));
const nodes = layers.map((n, li) => Array.from({ length: n }, (_, k) => ({ x: xs[li] ?? 0, y: H / 2 + (k - (n - 1) / 2) * 34 })));
const edges: { x1: number; y1: number; x2: number; y2: number; sig: boolean; delay: number }[] = [];
let e = 0;
for (let li = 0; li < layers.length - 1; li++) {
  for (const a of nodes[li] ?? []) for (const b of nodes[li + 1] ?? []) {
    // a deterministic subset of edges carries a signal; delays follow the layer so signals flow left to right
    const sig = (e * 7) % 5 === 0;
    edges.push({ x1: a.x, y1: a.y, x2: b.x, y2: b.y, sig, delay: li * 0.7 + ((e * 3) % 7) * 0.12 });
    e++;
  }
}
const loss = 'M4 8 C 30 10, 40 34, 62 40 S 100 50, 136 52';
---

<VizFrame title="model/train.py" status="training" label="Animated neural network with a training-loss curve, illustrating AIOps and MLOps research and AI & ML teaching">
  <div class="nv">
    <svg class="nv-svg" viewBox={`0 0 ${W} ${H}`}>
      <defs>
        <linearGradient id="nv-grad" x1="0" y1="0" x2={W} y2={H} gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="hsl(268 90% 72%)" />
          <stop offset="1" stop-color="hsl(200 90% 62%)" />
        </linearGradient>
        <radialGradient id="nv-node" cx="35%" cy="30%" r="75%">
          <stop offset="0" stop-color="#fff" stop-opacity="0.95" />
          <stop offset="0.35" stop-color="hsl(268 90% 75%)" />
          <stop offset="1" stop-color="hsl(230 70% 45%)" />
        </radialGradient>
      </defs>
      {edges.map((ed) => <line x1={ed.x1} y1={ed.y1} x2={ed.x2} y2={ed.y2} class="nv-edge" />)}
      {edges.filter((ed) => ed.sig).map((ed) => (
        <line x1={ed.x1} y1={ed.y1} x2={ed.x2} y2={ed.y2} class="nv-sig" pathLength="100" style={`animation-delay:${ed.delay.toFixed(2)}s`} />
      ))}
      {nodes.flat().map((n, i) => (
        <g class="nv-n" style={`--d:${((i * 0.37) % 2.8).toFixed(2)}s;transform-origin:${n.x}px ${n.y}px`}>
          <circle cx={n.x} cy={n.y} r="11" class="nv-halo" />
          <circle cx={n.x} cy={n.y} r="7" fill="url(#nv-node)" />
        </g>
      ))}
    </svg>

    <div class="nv-chip nv-chip--a">AIOps</div>
    <div class="nv-chip nv-chip--b">MLOps</div>

    <div class="nv-loss">
      <span class="nv-k">loss</span>
      <svg viewBox="0 0 140 56" class="nv-loss-svg">
        <path d={loss} class="nv-loss-path" pathLength="100" />
      </svg>
    </div>

    {courses.length > 0 && (
      <div class="nv-courses">
        {courses.map((c) => <span class="nv-course"><b>{c.level}</b>{c.name}</span>)}
      </div>
    )}
  </div>
</VizFrame>

<style>
  .nv { position: absolute; inset: 0; }
  .nv-svg { position: absolute; left: 4%; top: 6%; width: 64%; height: 70%; overflow: visible; }
  .nv-edge { stroke: hsl(var(--tint-h) 50% 70% / 0.16); stroke-width: 1; }
  .nv-sig { stroke: url(#nv-grad); stroke-width: 2; stroke-linecap: round; stroke-dasharray: 16 100; stroke-dashoffset: 116; animation: nv-flow 2.8s cubic-bezier(0.5, 0, 0.3, 1) infinite; }
  @keyframes nv-flow { 0% { stroke-dashoffset: 116; opacity: 0; } 10% { opacity: 1; } 70% { opacity: 1; } 100% { stroke-dashoffset: 0; opacity: 0; } }
  .nv-halo { fill: hsl(268 90% 70% / 0.18); }
  .nv-n { animation: nv-pulse 2.8s ease-in-out infinite; animation-delay: var(--d); }
  @keyframes nv-pulse { 0%, 100% { transform: scale(1); opacity: 0.85; } 50% { transform: scale(1.18); opacity: 1; } }

  .nv-chip { position: absolute; padding: 6px 12px; border-radius: 100px; font-family: var(--font-display); font-size: 10px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--fg);
    background: color-mix(in srgb, var(--panel-bg) 70%, transparent); border: 1px solid var(--glass-border); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.18), 0 0 0 1px hsl(268 90% 70% / 0.12); animation: viz-float 4s ease-in-out infinite; }
  .nv-chip::before { content: ''; display: inline-block; width: 6px; height: 6px; margin-right: 7px; border-radius: 50%; background: linear-gradient(135deg, hsl(268 90% 70%), hsl(200 90% 60%)); vertical-align: 1px; }
  .nv-chip--a { right: 6%; top: 10%; }
  .nv-chip--b { right: 12%; top: 26%; animation-delay: -2s; }

  .nv-loss { position: absolute; right: 5%; top: 44%; width: 30%; padding: 8px 10px 4px; border-radius: 12px; background: rgba(8, 10, 16, 0.55); border: 1px solid rgba(255, 255, 255, 0.08); }
  .nv-k { font-family: var(--font-mono); font-size: 9px; color: #A5B4FC; letter-spacing: 0.08em; }
  .nv-loss-svg { display: block; width: 100%; height: 40px; overflow: visible; }
  .nv-loss-path { fill: none; stroke: url(#nv-grad); stroke-width: 2; stroke-linecap: round; stroke-dasharray: 100; animation: nv-draw 5s ease-out infinite; }
  @keyframes nv-draw { 0% { stroke-dashoffset: 100; } 60%, 90% { stroke-dashoffset: 0; opacity: 1; } 100% { stroke-dashoffset: 0; opacity: 0; } }

  .nv-courses { position: absolute; left: 18px; right: 18px; bottom: 14px; display: flex; flex-wrap: wrap; gap: 8px; }
  .nv-course { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px 6px 6px; border-radius: 100px; font-size: 11px; color: var(--fg-muted); background: color-mix(in srgb, var(--panel-bg) 70%, transparent); border: 1px solid var(--line); }
  .nv-course b { font-family: var(--font-display); font-size: 8.5px; letter-spacing: 0.14em; color: #fff; padding: 3px 7px; border-radius: 100px; background: linear-gradient(135deg, hsl(268 80% 60%), hsl(230 75% 55%)); }

  @media (prefers-reduced-motion: reduce) { .nv-sig { stroke-dasharray: none; opacity: 0.5; } .nv-loss-path { stroke-dashoffset: 0; } }
  @media (max-width: 640px) { .nv-svg { width: 62%; height: 58%; top: 8%; } .nv-loss { display: none; } .nv-chip--a { top: 8%; right: 4%; } .nv-chip--b { top: 26%; right: 4%; } .nv-course { font-size: 10px; } }
</style>

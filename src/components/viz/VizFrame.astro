---
/**
 * macOS-style window used by the animated role visuals on Home.
 * Animations only run while the window is on screen (class .is-live), and are static with reduced motion.
 */
interface Props { title: string; status?: string; label: string }
const { title, status, label } = Astro.props;
---

<div class="viz" role="img" aria-label={label}>
  <div class="viz-bar" aria-hidden="true">
    <span class="viz-lights"><i></i><i></i><i></i></span>
    <span class="viz-title">{title}</span>
    {status && <span class="viz-status"><b></b>{status}</span>}
  </div>
  <div class="viz-body" aria-hidden="true"><slot /></div>
</div>

<script>
  function initViz() {
    const els = document.querySelectorAll<HTMLElement>('.viz:not([data-bound])');
    if (!els.length) return;
    if (!('IntersectionObserver' in window)) { els.forEach((el) => el.classList.add('is-live')); return; }
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) (e.target as HTMLElement).classList.toggle('is-live', e.isIntersecting);
    }, { rootMargin: '80px' });
    els.forEach((el) => { el.dataset.bound = '1'; io.observe(el); });
  }
  initViz();
  document.addEventListener('astro:page-load', initViz);
</script>

<style is:global>
  .viz { position: relative; height: 100%; display: flex; flex-direction: column; isolation: isolate; overflow: hidden;
    background:
      radial-gradient(120% 90% at 15% 0%, hsl(var(--tint-h) 80% 60% / 0.22), transparent 60%),
      radial-gradient(90% 80% at 100% 100%, hsl(calc(var(--tint-h) + 50) 70% 55% / 0.18), transparent 60%); }
  /* faint engineering grid */
  .viz::before { content: ''; position: absolute; inset: 0; z-index: -1; opacity: 0.5;
    background-image: linear-gradient(hsl(var(--tint-h) 60% 70% / 0.07) 1px, transparent 1px), linear-gradient(90deg, hsl(var(--tint-h) 60% 70% / 0.07) 1px, transparent 1px);
    background-size: 22px 22px; mask-image: radial-gradient(80% 80% at 50% 50%, #000 40%, transparent 100%); }
  .viz-bar { display: flex; align-items: center; gap: 12px; height: 34px; padding: 0 14px; border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--panel-bg) 60%, transparent); flex: none; }
  .viz-lights { display: inline-flex; gap: 6px; }
  .viz-lights i { width: 10px; height: 10px; border-radius: 50%; background: #FF5F57; box-shadow: inset 0 0 0 0.5px rgba(0, 0, 0, 0.2); }
  .viz-lights i:nth-child(2) { background: #FEBC2E; }
  .viz-lights i:nth-child(3) { background: #28C840; }
  .viz-title { font-family: var(--font-mono); font-size: 11px; color: var(--fg-subtle); letter-spacing: 0.02em; }
  .viz-status { margin-left: auto; display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 10px; color: #34D399; padding: 3px 9px; border-radius: 100px; background: rgba(52, 211, 153, 0.1); border: 1px solid rgba(52, 211, 153, 0.25); }
  .viz-status b { width: 6px; height: 6px; border-radius: 50%; background: #34D399; box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.6); animation: viz-ping 2s ease-out infinite; }
  .viz-body { position: relative; flex: 1; min-height: 0; }

  /* every animation inside a visual is paused until it scrolls into view */
  /* !important: the component styles use the animation shorthand, which would otherwise reset the play state */
  .viz:not(.is-live) *, .viz:not(.is-live) *::before, .viz:not(.is-live) *::after { animation-play-state: paused !important; }
  @media (prefers-reduced-motion: reduce) {
    .viz *, .viz *::before, .viz *::after { animation: none !important; }
  }

  @keyframes viz-ping { 0% { box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.55); } 80%, 100% { box-shadow: 0 0 0 7px rgba(52, 211, 153, 0); } }
  @keyframes viz-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
  @keyframes viz-comet { from { stroke-dashoffset: 112; } to { stroke-dashoffset: 0; } }
  @keyframes viz-glow { 0%, 100% { opacity: 0.35; } 50% { opacity: 1; } }

  /* glass node used by all three visuals */
  .viz-node { position: absolute; width: 46px; height: 46px; margin: -23px 0 0 -23px; border-radius: 15px; display: grid; place-items: center;
    background: color-mix(in srgb, var(--panel-bg) 75%, transparent); border: 1px solid var(--glass-border);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.18), inset 0 1px 0 rgba(255, 255, 255, 0.18);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
  .viz-node::after { content: ''; position: absolute; inset: -5px; border-radius: 19px; border: 1.5px solid hsl(var(--tint-h) 90% 65%); opacity: 0; transform: scale(0.9); }
  .viz-node .tech-logo { width: 26px; height: 26px; filter: none; }
  .viz-node-label { position: absolute; top: calc(100% + 7px); left: 50%; transform: translateX(-50%); font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.06em; color: var(--fg-subtle); white-space: nowrap; }
</style>

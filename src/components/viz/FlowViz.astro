---
/** Role 03 (freelance): how an engagement runs. A progress line fills step by step, each step checks off, and a booking card floats beside the tools. */
import VizFrame from './VizFrame.astro';
import TechLogo from '@components/TechLogo.astro';

const steps = [
  { label: 'Discovery call', icon: 'M8 3h8l1 4H7zM5 7h14v12a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2zM9 12h6M9 16h4' },
  { label: 'Written scope', icon: 'M7 3h7l5 5v11a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zM14 3v5h5M9 13h6M9 17h6' },
  { label: 'Delivery', icon: 'M12 3l8 4.5v9L12 21l-8-4.5v-9zM12 12l8-4.5M12 12v9M12 12L4 7.5' },
  { label: 'Handover', icon: 'M5 12l4 4L19 6' },
];
const tools = ['kubernetes', 'terraform', 'docker', 'github-actions', 'python', 'azure'];
---

<VizFrame title="engagement/plan.md" status="available" label="Animated engagement timeline: discovery call, written scope, delivery, handover">
  <div class="fv">
    <div class="fv-steps">
      <div class="fv-line"><span class="fv-fill"></span></div>
      {steps.map((s, i) => (
        <div class="fv-step" style={`--i:${i}`}>
          <span class="fv-dot">
            <svg viewBox="0 0 24 24" class="fv-ico"><path d={s.icon} /></svg>
            <svg viewBox="0 0 24 24" class="fv-check"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
          </span>
          <span class="fv-label">{s.label}</span>
        </div>
      ))}
    </div>

    <div class="fv-bottom">
      <div class="fv-card">
        <p class="fv-card-k">Intro call</p>
        <p class="fv-card-t">30 minutes, online</p>
        <div class="fv-slots">
          {Array.from({ length: 10 }, (_, i) => <span class:list={['fv-slot', { 'fv-slot--pick': i === 6 }]}></span>)}
        </div>
      </div>
      <div class="fv-dock">
        {tools.map((t, i) => <span class="fv-tool" style={`--i:${i}`}><TechLogo slug={t} size={26} /></span>)}
      </div>
    </div>
  </div>
</VizFrame>

<style>
  .fv { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: space-between; padding: 26px 22px 18px; }
  .fv-steps { position: relative; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .fv-line { position: absolute; left: 12.5%; right: 12.5%; top: 21px; height: 2px; border-radius: 2px; background: var(--line); overflow: hidden; }
  .fv-fill { position: absolute; inset: 0; transform-origin: left; transform: scaleX(0); background: linear-gradient(90deg, hsl(174 80% 50%), hsl(215 90% 62%), hsl(268 85% 68%)); box-shadow: 0 0 10px hsl(190 90% 60% / 0.7); animation: fv-fill 8s cubic-bezier(0.65, 0, 0.35, 1) infinite; }
  @keyframes fv-fill { 0% { transform: scaleX(0); } 70% { transform: scaleX(1); } 94% { transform: scaleX(1); opacity: 1; } 100% { transform: scaleX(1); opacity: 0; } }

  .fv-step { position: relative; display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .fv-dot { position: relative; width: 44px; height: 44px; border-radius: 14px; display: grid; place-items: center;
    background: color-mix(in srgb, var(--panel-bg) 78%, transparent); border: 1px solid var(--glass-border); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.18); animation: fv-done-0 8s ease-out infinite; }
  .fv-step:nth-child(3) .fv-dot { animation-name: fv-done-1; }
  .fv-step:nth-child(4) .fv-dot { animation-name: fv-done-2; }
  .fv-step:nth-child(5) .fv-dot { animation-name: fv-done-3; }
  .fv-dot svg { position: absolute; width: 20px; height: 20px; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .fv-ico { stroke: hsl(var(--tint-h) 70% 60%); animation: fv-out-0 8s ease infinite; }
  .fv-step:nth-child(3) .fv-ico { animation-name: fv-out-1; }
  .fv-step:nth-child(4) .fv-ico { animation-name: fv-out-2; }
  .fv-step:nth-child(5) .fv-ico { animation-name: fv-out-3; }
  .fv-check { stroke: #fff; opacity: 0; transform: scale(0.4); animation: fv-in-0 8s ease-out infinite; }
  .fv-step:nth-child(3) .fv-check { animation-name: fv-in-1; }
  .fv-step:nth-child(4) .fv-check { animation-name: fv-in-2; }
  .fv-step:nth-child(5) .fv-check { animation-name: fv-in-3; }
  @keyframes fv-done-0 { 0%, 0.0% { background: color-mix(in srgb, var(--panel-bg) 78%, transparent); transform: scale(1); } 3.0% { transform: scale(1.14); } 6.0%, 94% { background: linear-gradient(135deg, hsl(174 75% 45%), hsl(215 85% 58%)); transform: scale(1); } 98%, 100% { background: color-mix(in srgb, var(--panel-bg) 78%, transparent); } }
  @keyframes fv-out-0 { 0%, 0.0% { opacity: 1; } 3.0%, 94% { opacity: 0; } 98%, 100% { opacity: 1; } }
  @keyframes fv-in-0 { 0%, 0.0% { opacity: 0; transform: scale(0.4); } 6.0%, 94% { opacity: 1; transform: scale(1); } 98%, 100% { opacity: 0; transform: scale(0.4); } }
  @keyframes fv-done-1 { 0%, 23.3% { background: color-mix(in srgb, var(--panel-bg) 78%, transparent); transform: scale(1); } 26.3% { transform: scale(1.14); } 29.3%, 94% { background: linear-gradient(135deg, hsl(174 75% 45%), hsl(215 85% 58%)); transform: scale(1); } 98%, 100% { background: color-mix(in srgb, var(--panel-bg) 78%, transparent); } }
  @keyframes fv-out-1 { 0%, 23.3% { opacity: 1; } 26.3%, 94% { opacity: 0; } 98%, 100% { opacity: 1; } }
  @keyframes fv-in-1 { 0%, 23.3% { opacity: 0; transform: scale(0.4); } 29.3%, 94% { opacity: 1; transform: scale(1); } 98%, 100% { opacity: 0; transform: scale(0.4); } }
  @keyframes fv-done-2 { 0%, 46.6% { background: color-mix(in srgb, var(--panel-bg) 78%, transparent); transform: scale(1); } 49.6% { transform: scale(1.14); } 52.6%, 94% { background: linear-gradient(135deg, hsl(174 75% 45%), hsl(215 85% 58%)); transform: scale(1); } 98%, 100% { background: color-mix(in srgb, var(--panel-bg) 78%, transparent); } }
  @keyframes fv-out-2 { 0%, 46.6% { opacity: 1; } 49.6%, 94% { opacity: 0; } 98%, 100% { opacity: 1; } }
  @keyframes fv-in-2 { 0%, 46.6% { opacity: 0; transform: scale(0.4); } 52.6%, 94% { opacity: 1; transform: scale(1); } 98%, 100% { opacity: 0; transform: scale(0.4); } }
  @keyframes fv-done-3 { 0%, 69.9% { background: color-mix(in srgb, var(--panel-bg) 78%, transparent); transform: scale(1); } 72.9% { transform: scale(1.14); } 75.9%, 94% { background: linear-gradient(135deg, hsl(174 75% 45%), hsl(215 85% 58%)); transform: scale(1); } 98%, 100% { background: color-mix(in srgb, var(--panel-bg) 78%, transparent); } }
  @keyframes fv-out-3 { 0%, 69.9% { opacity: 1; } 72.9%, 94% { opacity: 0; } 98%, 100% { opacity: 1; } }
  @keyframes fv-in-3 { 0%, 69.9% { opacity: 0; transform: scale(0.4); } 75.9%, 94% { opacity: 1; transform: scale(1); } 98%, 100% { opacity: 0; transform: scale(0.4); } }
  .fv-label { font-family: var(--font-display); font-size: 9.5px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--fg-muted); text-align: center; }

  .fv-bottom { display: flex; align-items: flex-end; justify-content: space-between; gap: 14px; }
  .fv-card { width: 46%; padding: 12px 14px; border-radius: 14px; background: color-mix(in srgb, var(--panel-bg) 78%, transparent); border: 1px solid var(--glass-border); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); box-shadow: 0 10px 24px rgba(0, 0, 0, 0.2); animation: viz-float 5s ease-in-out infinite; }
  .fv-card-k { margin: 0; font-family: var(--font-display); font-size: 9px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: hsl(var(--tint-h) 70% 55%); }
  .fv-card-t { margin: 2px 0 10px; font-size: 12.5px; color: var(--fg); }
  .fv-slots { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 5px; }
  .fv-slot { height: 9px; border-radius: 4px; background: var(--line); }
  .fv-slot--pick { background: linear-gradient(90deg, hsl(174 80% 48%), hsl(215 90% 60%)); animation: viz-glow 2.4s ease-in-out infinite; }

  .fv-dock { display: flex; gap: 6px; padding: 7px; border-radius: 16px; background: color-mix(in srgb, var(--panel-bg) 70%, transparent); border: 1px solid var(--glass-border); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); }
  .fv-tool { width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; background: color-mix(in srgb, var(--panel-bg) 60%, transparent); animation: fv-bob 3.2s ease-in-out infinite; animation-delay: calc(var(--i) * 0.22s); }
  .fv-tool :global(.tech-logo) { width: 22px; height: 22px; filter: none; }
  @keyframes fv-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }

  @media (prefers-reduced-motion: reduce) { .fv-fill { transform: scaleX(1); } }
  @media (max-width: 640px) { .fv-dock { display: none; } .fv-card { width: 100%; } .fv-label { font-size: 8px; letter-spacing: 0.06em; } }
</style>
